#!/usr/bin/env bash
# cageworks -- run a factory of named roles over one repository.
#
# What an operator types. It files goals, reads back what is there, enters a
# role by hand, and hands the factory's work to the operator's own repository.
# None of it knows where the cages are: every guest command goes over ssh to
# the machine cageworks built for that factory, and guest() is the only thing
# here that touches the transport (ADR-018, ADR-019).

set -euo pipefail

CAGEWORKS_VERSION="1.0.0"

## What the operator's side reads: their own ceilings and the register of
## factories on this machine (ADR-020). The guest program has its own copy of
## the modules it needs; these are the ones that only make sense where the
## operator's config lives, which is here and never in a cage.
CAGEWORKS_LIB="${CAGEWORKS_LIB:-@lib@}"
# shellcheck source=modules/names.sh
. "$CAGEWORKS_LIB/names.sh"
# shellcheck source=modules/schema.sh
. "$CAGEWORKS_LIB/schema.sh"
# shellcheck source=modules/sizes.sh
. "$CAGEWORKS_LIB/sizes.sh"
# shellcheck source=modules/resources.sh
. "$CAGEWORKS_LIB/resources.sh"
# shellcheck source=modules/operator-config.sh
. "$CAGEWORKS_LIB/operator-config.sh"
# shellcheck source=modules/repo-declaration.sh
. "$CAGEWORKS_LIB/repo-declaration.sh"
# shellcheck source=modules/machine.sh
. "$CAGEWORKS_LIB/machine.sh"

## The flake a machine is built from: cageworks' own. Substituted at package
## time so an installed cageworks builds the machine its own revision
## describes, and overridable so a developer and the suite can point at a
## working tree.
CAGEWORKS_SELF="${CAGEWORKS_SELF:-@self@}"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

log_info() { echo -e "${CYAN}[cageworks]${NC} $*"; }
log_ok()   { echo -e "${GREEN}[cageworks]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[cageworks]${NC} $*"; }
log_err()  { echo -e "${RED}[cageworks]${NC} $*" >&2; }

## What builds a machine, locks its flake and reads the spec back out of it.
## Named once for the same reason as the above: everything nix does for a
## machine goes through it, so it is the one thing a test has to stand in for.
NIX="${CAGEWORKS_NIX:-nix}"

## Run a guest command on the factory's own machine and return its output.
##
## The words are sent NUL-separated and split by xargs -0 on the far side, so
## the remote command is three fixed words and nothing a caller passed is ever
## quoted for a remote shell or re-split. ssh would otherwise join argv into one
## string, and a task's acceptance or a role's outcome would be part of it.
##
## Which machine is read off the verb's own first argument: every guest verb
## takes the factory there, which is the guest program's dispatch convention
## rather than a coincidence of these call sites.
guest() {
  local factory="${2:-}"
  [[ -n "$factory" ]] || { log_err "no factory named for guest command ${1:-}"; return 1; }

  ## Captured before the loop, because a failure inside a process substitution
  ## does not reach the while that reads it: the args would come back empty and
  ## ssh would go to localhost on port 22 with no key.
  local args
  args="$(cageworks_machine_ssh_args "$factory")" || return 1
  local -a ssh_args=()
  local arg
  while IFS= read -r arg; do ssh_args+=("$arg"); done <<<"$args"

  printf '%s\0' "$@" |
    ssh "${ssh_args[@]}" root@localhost xargs -0 cageworks-container
}

## A goal, filed into a factory. The workflow's first stage says who takes it
## and the decider says when; the operator never picks a role by hand. The
## title and body reach the machine as words and become files there, so the
## executor reads files and never argv (the second invariant).
cmd_task() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
  file)
    local factory="${1:-}" workflow="${2:-}" title="${3:-}" body="${4:-}"
    if [[ -z "$factory" || -z "$workflow" || -z "$title" ]]; then
      log_err "usage: cageworks task file <factory> <workflow> <title> [body]"
      exit 1
    fi
    guest task-file "$factory" "$workflow" "$title" "$body"
    ;;
  *)
    log_err "usage: cageworks task file <factory> <workflow> <title> [body]"
    exit 1
    ;;
  esac
}

## Enter a declared factory role by hand. Unlike a task run this is a person:
## the session signs through their forwarded agent, exactly as entering an
## ordinary project does, and ADR-009's cage key belongs to the run nobody
## watches.
cmd_role() {
  ## 'role stop <factory> <role>' ends a role's running turn through the
  ## executor (ADR-039); everything else here is a person entering by hand.
  if [[ "${1:-}" == stop ]]; then
    local factory="${2:-}" role="${3:-}"
    if [[ -z "$factory" || -z "$role" ]]; then
      log_err "usage: cageworks role stop <factory> <role>"
      exit 1
    fi
    guest role-stop "$factory" "$role"
    return
  fi
  ## 'role steer <factory> <role> <text>' speaks into a running turn; the
  ## words go to the executor, which queues them at the next tool boundary.
  if [[ "${1:-}" == steer ]]; then
    local factory="${2:-}" role="${3:-}" text="${4:-}"
    if [[ -z "$factory" || -z "$role" || -z "$text" ]]; then
      log_err "usage: cageworks role steer <factory> <role> <text>"
      exit 1
    fi
    guest role-steer "$factory" "$role" "$text"
    return
  fi

  local factory="${1:-}" role="${2:-}"
  if [[ -z "$factory" || -z "$role" ]]; then
    log_err "usage: cageworks role <factory> <role> [-- cmd...]"
    exit 1
  fi
  shift 2

  # Accept both 'role f r -- cmd...' and 'role f r cmd...'.
  [[ "${1:-}" == "--" ]] && shift

  # The socket the session signs through lives on the far side of the
  # transport, so it is named there rather than here: on macOS its path is the
  # VM's and nothing on this side can spell it. Both programs are told, and
  # they are told different things -- nixcage forwards the agent and carries
  # the variable across sudo, cageworks-container reads it once it is there.
  local -a forward=() use_agent=()
  if [[ -n "${SSH_AUTH_SOCK:-}" && -e "${SSH_AUTH_SOCK}" ]]; then
    forward=(-A)
    use_agent=(--agent)
  fi

  if [[ $# -eq 0 ]]; then
    log_info "Entering role $role of factory $factory..."
    forward+=(-t)
  fi

  ## Where this factory's repository is, as a remote the machine can reach
  ## (ADR-032). The register names a checkout on this host, which the machine
  ## cannot open and which is not what it works from: the origin of that
  ## checkout is. Read here rather than declared a second time, because two
  ## places naming one remote are two places that can disagree.
  ##
  ## The guest needs it the first time only, since after that its clone records
  ## where it was cloned from.
  local repository=()
  local origin
  if cageworks_operator_factory_path "$(cageworks_operator_config_path)" "$factory" >/dev/null 2>&1; then
    origin="$(factory_origin "$factory")" || exit 1
    repository=(--repository "$origin")
  fi

  local args
  args="$(cageworks_machine_ssh_args "$factory")" || exit 1
  local -a ssh_args=()
  local arg
  while IFS= read -r arg; do ssh_args+=("$arg"); done <<<"$args"

  ## Same NUL framing as guest(), for the same reason: a session command is
  ## words the declaration wrote and nothing re-splits them on the way.
  printf '%s\0' role-enter ${use_agent[@]+"${use_agent[@]}"} \
    ${repository[@]+"${repository[@]}"} "$factory" "$role" "$@" |
    ssh "${ssh_args[@]}" ${forward[@]+"${forward[@]}"} root@localhost \
      xargs -0 cageworks-container
}

## The guest is always Linux, whatever the operator is on. A machine that
## reported the host's system would build a darwin guest and fail late.
host_system() {
  nix eval --impure --raw --expr 'builtins.currentSystem'
}

## The guest is always Linux, whatever the operator is on.
guest_system() {
  local host
  host="$(host_system)" || return 1
  case "$host" in
  aarch64-*) echo "aarch64-linux" ;;
  x86_64-*) echo "x86_64-linux" ;;
  *)
    log_err "no Linux guest for $host"
    return 1
    ;;
  esac
}

## What one factory's machine is, as the spec modules/vm.nix takes. Built from
## the declaration the repository committed, clamped by this host's ceilings,
## plus the way in that belongs to this factory alone.
## Where this factory's repository is, as a remote the machine can reach
## (ADR-032). The register names a checkout on this host, which the machine
## cannot open; the origin of that checkout is what it clones. Read here
## rather than declared a second time, because two places naming one remote
## are two places that can disagree.
factory_origin() {
  local factory="$1" path origin
  path="$(cageworks_operator_factory_path "$(cageworks_operator_config_path)" "$factory")" || return 1
  if origin="$(git -C "$path" remote get-url origin 2>/dev/null)" && [[ -n "$origin" ]]; then
    printf '%s\n' "$origin"
  else
    log_err "$factory's repository at $path has no origin, and a machine cannot clone a path on this host"
    return 1
  fi
}

## The flake one factory's machine is built from (ADR-040). Written every
## time, because it is ours and nothing in it is the operator's to keep; the
## lock beside it is theirs and is only made on the first build or moved on
## request. Two inputs: this cageworks, and the repository the factory works,
## pinned by rev in the lock so that which declaration a machine runs is the
## machine's identity. Beside the flake, the facts only this host knows, as a
## file the build reads: the way in, both systems, the ceilings, and which
## header carries which endpoint's credential. Never the credential.
machine_flake() {
  local factory="$1" machine="$2" dir config path
  dir="$(cageworks_machine_dir "$factory")" || return 1
  config="$(cageworks_operator_config_path)"
  path="$(cageworks_operator_factory_path "$config" "$factory")" || return 1
  path="$(cd "$path" 2>/dev/null && pwd)" || {
    log_err "$factory's repository is not at the path the config names: $path"
    return 1
  }
  mkdir -p "$machine"

  local caps creds
  caps="$(cageworks_operator_caps "$config")" || return 1
  creds="$(cageworks_operator_credentials "$config")" || return 1
  jq -n \
    --arg factory "$factory" \
    --arg system "$(guest_system)" \
    --arg hostSystem "$(host_system)" \
    --argjson port "$(cat "$dir/port")" \
    --arg key "$(cat "$dir/id_ed25519.pub")" \
    --argjson caps "$caps" \
    --argjson creds "$creds" '
      { factory: $factory, system: $system, hostSystem: $hostSystem,
        sshPort: $port, authorizedKey: $key, caps: $caps,
        credentials: ($creds | map_values(.header)) }' >"$machine/local.json.new" || return 1
  mv "$machine/local.json.new" "$machine/local.json"

  cat >"$machine/flake.nix.new" <<EOF
## Generated by cageworks for the factory $factory. Nothing here is edited by
## hand; the lock beside it is what pins which declaration this machine runs.
{
  description = "The machine the factory $factory runs in";
  inputs = {
    cageworks.url = $(cageworks_nix_string "path:$CAGEWORKS_SELF");
    project.url = $(cageworks_nix_string "git+file://$path");
  };
  outputs = { cageworks, project, ... }:
    let factory = cageworks.lib.factory { inherit project; local = ./local.json; };
    in {
      packages.\${factory.hostSystem}.runner = factory.runner;
      spec = factory.spec;
    };
}
EOF
  mv "$machine/flake.nix.new" "$machine/flake.nix"
}

## The machines on this host. A factory runs in one of its own (ADR-019), and
## this says which of them are here and how each is reached.
##
## Only 'status' is here yet: building and booting a machine is the rest of
## PRD-004 phase 2, and a verb that claimed to do it would be a verb that lied.
## Build and boot one factory's machine. Idempotent: a machine already running
## is the state this asks for, so saying so and stopping is the whole of it.
cmd_up() {
  local factory="${1:-}" update=""
  if [[ -z "$factory" ]]; then
    log_err "usage: cageworks up <factory> [--update]"
    exit 1
  fi
  [[ "${2:-}" == --update ]] && update=1
  if cageworks_machine_running "$factory"; then
    log_ok "$factory is already running"
    return
  fi
  local dir machine runner
  dir="$(cageworks_machine_ensure "$factory")" || exit 1
  machine="$dir/machine"
  machine_flake "$factory" "$machine" || exit 1

  ## The project is pinned once and moved only when asked, because which
  ## declaration a machine runs is its identity (ADR-040). cageworks itself
  ## follows the one running, because a machine built from an older cageworks
  ## than the CLI driving it is the drift the lock exists to prevent.
  if [[ ! -f "$machine/flake.lock" ]]; then
    "$NIX" flake lock "path:$machine" || {
      log_err "could not pin the repository $factory works"
      exit 1
    }
  elif [[ -n "$update" ]]; then
    "$NIX" flake update project --flake "path:$machine" || {
      log_err "could not move $factory to the repository's current commit"
      exit 1
    }
  fi
  "$NIX" flake update cageworks --flake "path:$machine" || exit 1

  log_info "Building the machine $factory runs in..."
  runner="$("$NIX" build --no-link --print-out-paths "path:$machine#runner")" || {
    log_err "could not build the machine $factory runs in"
    exit 1
  }
  ## The spec the build composed, read back for what this side still does
  ## with it: filing credentials, and saying what the clamp changed.
  "$NIX" eval --json "path:$machine#spec" >"$dir/spec.json.new" || {
    log_err "could not read back the spec $factory was built from"
    exit 1
  }
  mv "$dir/spec.json.new" "$dir/spec.json"
  local note
  while IFS= read -r note; do
    [[ -n "$note" ]] && log_info "$note"
  done < <(jq -r '.notes[]?' "$dir/spec.json")

  ## Volumes are made in the working directory, which is why the runner is
  ## started in the machine's own: its disk belongs beside its key and its
  ## port, and no factory writes into another's.
  log_info "Starting $factory on port $(cageworks_machine_port "$factory")..."
  ## Detached into a session of its own. A machine that ends when the command
  ## that started it ends is not one anything can be run in later, and every
  ## verb after this asks whether it is still up.
  local runner_pid
  runner_pid="$(cd "$dir" && cageworks_machine_spawn "$dir/console.log" "$runner/bin/microvm-run")"
  disown "$runner_pid" 2>/dev/null || true
  echo "$runner_pid" >"$dir/pid.new"
  mv "$dir/pid.new" "$dir/pid"
  give_credentials "$factory" "$(cat "$dir/spec.json")" || exit 1
  ## What the machine needs to have before a factory can run on it, made
  ## once and confirmed on every up (ADR-036). On the machine, because that
  ## is where the forge and the bus are.
  guest factory-prepare "$factory" "$(factory_origin "$factory")" || {
    log_err "could not prepare the factory on $factory's machine"
    exit 1
  }
  log_ok "$factory is running"
}

## Put this factory's credentials where only its proxy can read them
## (ADR-025 point 1). They go over the machine's own transport after it is up,
## because the pool they land on does not exist until it has booted.
##
## Each secret is piped into a remote install(1) rather than passed to it. An
## argument is readable from /proc by anything on the machine, and the whole
## point of the credential being here is that it is readable by one uid.
give_credentials() {
  local factory="$1" spec="$2" config creds hosts host file
  hosts="$(printf '%s' "$spec" | jq -r '(.egressHeaders // {}) | keys[]?')"
  [[ -n "$hosts" ]] || return 0

  config="$(cageworks_operator_config_path)"
  creds="$(cageworks_operator_credentials "$config")" || return 1

  local args
  args="$(cageworks_machine_ssh_args "$factory")" || return 1
  local -a ssh_args=()
  local arg
  while IFS= read -r arg; do ssh_args+=("$arg"); done <<<"$args"

  ## The machine was started a moment ago and is not answering yet.
  local waited=0
  until ssh "${ssh_args[@]}" root@localhost true 2>/dev/null; do
    if [[ "$waited" -ge 60 ]]; then
      log_err "$factory did not answer in time to be given its credentials"
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done

  while IFS= read -r host; do
    [[ -n "$host" ]] || continue
    file="$(printf '%s' "$creds" | jq -r --arg h "$host" '.[$h].file // empty')"
    if [[ ! -f "$file" ]]; then
      log_err "the credential for $host is not at $file"
      return 1
    fi
    ## The machine is asked to file the credential rather than told where to
    ## put it. Reaching into nixcage's state layout from here is the coupling
    ## ADR-018 exists to remove, and the machine already knows its own.
    ##
    ## $host expands here on purpose. The operator's config is refused when a
    ## credential is keyed by something that is not a host, so what reaches the
    ## far side is a name and never an expression.
    # shellcheck disable=SC2029
    if ! ssh "${ssh_args[@]}" root@localhost \
      "cageworks-egress-credential $host" \
      <"$file"; then
      log_err "could not give $factory the credential for $host"
      return 1
    fi
  done <<<"$hosts"

  ## The proxy read its headers when it started, which was before any of this.
  if ! ssh "${ssh_args[@]}" root@localhost \
    "systemctl restart cageworks-egress-credentials nginx" >/dev/null 2>&1; then
    log_err "$factory has its credentials but its proxy would not pick them up"
    return 1
  fi
}

## Stop a factory's machine by shutting its guest down. A stop that cannot
## complete is reported and the machine keeps running: ADR-017 exists because
## one was ended rather than shut down, and cageworks owns the stopping now.
cmd_down() {
  local factory="${1:-}"
  if [[ -z "$factory" ]]; then
    log_err "usage: cageworks down <factory>"
    exit 1
  fi

  if ! cageworks_machine_running "$factory"; then
    log_ok "$factory is not running"
    return
  fi

  local args
  args="$(cageworks_machine_ssh_args "$factory")" || return 1
  local -a ssh_args=()
  local arg
  while IFS= read -r arg; do ssh_args+=("$arg"); done <<<"$args"

  log_info "Shutting $factory down..."
  ## Asked in two steps because one would conflate two different answers. A
  ## machine that cannot be reached has refused; a machine that powers off
  ## takes the connection down with it, so ssh reports a dropped connection
  ## for the successful case and its verdict on the poweroff itself is worth
  ## nothing. Whether it stopped is whether the process ended.
  if ! ssh "${ssh_args[@]}" root@localhost true 2>/dev/null; then
    log_err "$factory would not accept a shutdown; it is still running"
    exit 1
  fi
  ssh "${ssh_args[@]}" root@localhost systemctl poweroff >/dev/null 2>&1 || true

  local pid waited=0
  pid="$(cageworks_machine_pid "$factory")"
  while kill -0 "$pid" 2>/dev/null; do
    if [[ "$waited" -ge 60 ]]; then
      log_err "$factory has not stopped after 60s; it is still running and has not been killed"
      exit 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  rm -f "$(cageworks_machine_dir "$factory")/pid"
  log_ok "$factory has stopped"
}

cmd_vm() {
  local sub="${1:-}"
  case "$sub" in
  status)
    local factory port dir
    while IFS= read -r factory; do
      [ -n "$factory" ] || continue
      port="$(cageworks_machine_port "$factory" 2>/dev/null)" || port="-"
      dir="$(cageworks_machine_dir "$factory")" || continue
      local state="stopped"
      cageworks_machine_running "$factory" && state="running"
      if [ -f "$dir/pool.img" ]; then
        printf '%s\tport %s\t%s\tdisk\n' "$factory" "$port" "$state"
      else
        printf '%s\tport %s\t%s\tno disk yet\n' "$factory" "$port" "$state"
      fi
    done < <(cageworks_machine_list)
    ;;
  *)
    log_err "usage: cageworks vm status"
    exit 1
    ;;
  esac
}

## The factory as a whole: what it is doing, handing its work to the operator,
## and starting it again after it stopped itself.
cmd_factory() {
  local sub="${1:-}" factory="${2:-}"
  if [[ -z "$sub" || -z "$factory" ]]; then
    log_err "usage: cageworks factory mirror|watch|send|console <factory>"
    exit 1
  fi
  case "$sub" in
  mirror)
    ## Merged main and the record leave the machine on the operator's word
    ## and never before (ADR-036 point 7).
    guest factory-mirror "$factory"
    ;;
  watch)
    ## The bus as JSONL on stdout, relayed over the machine's ssh port; what
    ## the TUI reads, and what any other client would (ADR-039 point 2).
    guest factory-watch "$factory" "${@:3}"
    ;;
  send)
    ## A command in the decider's vocabulary, from the operator, validated by
    ## the executor as the decider's would be.
    local json="${3:-}"
    if [[ -z "$json" ]]; then
      log_err "usage: cageworks factory send <factory> '<json command>'"
      exit 1
    fi
    guest factory-send "$factory" "$json"
    ;;
  console)
    ## The one face (ADR-039 point 3): the TUI, on this host, over the relay.
    ## Its roles come from the machine's declaration, over the same transport
    ## that carries the relay.
    local roles
    roles="$(guest factory-roles "$factory")" || exit 1
    # shellcheck disable=SC2086  # roles are one word each by construction
    exec cageworks-tui "$factory" $roles
    ;;
  *)
    log_err "usage: cageworks factory mirror|watch|send|console <factory>"
    exit 1
    ;;
  esac
}

cmd_help() {
  cat <<HELP
${BOLD}cageworks${NC} v${CAGEWORKS_VERSION} -- a factory of named roles over one repository

${BOLD}Usage:${NC}
  cageworks <command> [args...]

${BOLD}Commands:${NC}
  role <factory> <role> [-- cmd...]
                     Enter a declared role in its own worktree and uid, by hand
  role stop <factory> <role>
                     End a role's running turn, through the executor
  task file <factory> <workflow> <title> [body]
                     File a goal; the decider assigns it and nothing is typed
                     after it
  factory mirror <factory>
                     Push merged main and the record to the repository's origin
  factory watch <factory> [--from <id>]
                     The factory's bus as JSON lines, live, until interrupted
  factory send <factory> '<json>'
                     A command in the decider's vocabulary, from you
  factory console <factory>
                     The one face: roles, board, live stream, and the keys
                     that file, steer, stop, retry, block, push and mirror
  role steer <factory> <role> <text>
                     Speak into a role's running turn
  up <factory> [--update]
                     Build and boot the machine a factory runs in, pinned to
                     the repository's commit; --update moves the pin to HEAD
  down <factory>     Shut it down, reporting a stop that cannot complete
  vm status          The machines on this host, and how each is reached
  version            Print version
  help               Show this help

${BOLD}Configuration:${NC}
  A repository declares the factory that works it, as the 'cageworks' output
  of its own flake, and it is read from the commit rather than the working
  tree:

    cageworks = {
      name = "acme";
      roles.builder = { command = [ "claude" ]; provides = [ "build" ]; };
      workflows.ship.stages = [ { needs = "build"; } ];
    };

  Your own config is one file, ~/.config/cageworks/config.toml, saying what a
  factory may cost here and which factories live here:

    [caps]
    memory = "16G"
    [factories.acme]
    path = "/home/me/Src/acme"

  A factory works a clone of that repository rather than your checkout;
  what it merges reaches the repository's origin with 'cageworks factory
  mirror', and only then.
HELP
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
  role)    cmd_role "$@" ;;
  up)      cmd_up "$@" ;;
  down)    cmd_down "$@" ;;
  vm)      cmd_vm "$@" ;;
  task)    cmd_task "$@" ;;
  factory) cmd_factory "$@" ;;
  version | --version | -v) echo "cageworks $CAGEWORKS_VERSION" ;;
  help | --help | -h) cmd_help ;;
  *)
    log_err "Unknown command: $command"
    cmd_help
    exit 1
    ;;
  esac
}

# Allow sourcing without executing (for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
