#!/usr/bin/env bash
# cageworks-container -- the factory, on the machine the cages are on.
#
# Everything here is about several named workers sharing one repository: roles,
# capabilities, tasks, workflows, stage policies, the record, integration. None
# of it is about a cage. Where a cage is needed this calls nixcage-container,
# which is the whole of what cageworks knows about how one is built (ADR-018).
#
# A real script rather than a Nix string so that shellcheck reads it and the
# bats suite drives it directly. The Nix module wraps it, setting CAGEWORKS_LIB
# to the store directory holding the shell modules it sources.

set -euo pipefail

# Where the shell modules and the role guidance live. Set by the Nix wrapper to
# a store path; the suite points it at the working tree.
CAGEWORKS_LIB="${CAGEWORKS_LIB:-@lib@}"

# shellcheck source=modules/names.sh
. "$CAGEWORKS_LIB/names.sh"
# shellcheck source=modules/role-worktree.sh
. "$CAGEWORKS_LIB/role-worktree.sh"
# shellcheck source=modules/factory-clone.sh
. "$CAGEWORKS_LIB/factory-clone.sh"
# shellcheck source=modules/signing.sh
. "$CAGEWORKS_LIB/signing.sh"
# shellcheck source=modules/factory-config.sh
. "$CAGEWORKS_LIB/factory-config.sh"
# shellcheck source=modules/schema.sh
. "$CAGEWORKS_LIB/schema.sh"
# shellcheck source=modules/sizes.sh
. "$CAGEWORKS_LIB/sizes.sh"
# shellcheck source=modules/resources.sh
. "$CAGEWORKS_LIB/resources.sh"
# shellcheck source=modules/repo-declaration.sh
. "$CAGEWORKS_LIB/repo-declaration.sh"
# shellcheck source=modules/role-guidance.sh
. "$CAGEWORKS_LIB/role-guidance.sh"
# shellcheck source=modules/machine-plan.sh
. "$CAGEWORKS_LIB/machine-plan.sh"
# shellcheck source=modules/forge.sh
. "$CAGEWORKS_LIB/forge.sh"
# shellcheck source=modules/bus.sh
. "$CAGEWORKS_LIB/bus.sh"
# shellcheck source=modules/operator.sh
. "$CAGEWORKS_LIB/operator.sh"

# The clones, the worktrees, the keys, the tasks. This is the directory nixcage
# mounts its pool at, and it stays there: the storage primitive can only name a
# dataset for a path the pool already covers, so a state root of our own would
# buy a tidier name and cost every factory its datasets (ADR-018).
STATE_DIR="${CAGEWORKS_STATE:-/var/lib/nixcage}"

# What the machine's build put on it: the bridge plan and each role's profile
# (ADR-040). Overridable so the suite can put a machine's facts in a scratch
# directory.
CAGEWORKS_ETC="${CAGEWORKS_ETC:-/etc/cageworks}"


## The declaration a factory is working, read out of its own clone (ADR-020)
## rather than out of a tree somebody rendered.
##
## The declaration this machine was built with (ADR-040): a file the build
## wrote, validated and clamped, and never evaluated here. A machine is one
## factory's, so a request naming another factory is a mistake to say.
factory_declaration() {
	local factory="$1" file="$CAGEWORKS_ETC/declaration.json" built
	[ -f "$file" ] || die "this machine carries no declaration at $file"
	built="$(jq -r '.name // empty' "$file")"
	[ "$built" = "$factory" ] || die "this machine runs the factory $built, not $factory"
	printf '%s\n' "$file"
}

## One limit out of the declaration's resources, with the caller's default
## when the declaration states none.
factory_limit() {
	local factory="$1" field="$2" default="$3" value
	value="$(jq -r --arg f "$field" '.resources[$f] // empty' "$(factory_declaration "$factory")")" || return 1
	printf '%s\n' "${value:-$default}"
}

## Where a factory's clone came from. Nothing declares this: a clone records
## where it was cloned from, which is what a clone is.
## Where a factory's repository is. The clone records it once it exists;
## before that, the origin cageworks up filed on the machine (ADR-032, ADR-040):
## the executor starts every session, and a session needs no origin on argv.
factory_repository() {
	local factory="$1" clone
	clone="$(cageworks_factory_clone_path "$STATE_DIR" "$factory")" || return 1
	if [ -d "$clone" ]; then
		git -C "$clone" remote get-url origin
	elif [ -s "$STATE_DIR/origin" ]; then
		cat "$STATE_DIR/origin"
	else
		die "$factory has no clone yet, and no origin was filed; run cageworks up"
	fi
}

die() {
	echo "cageworks-container: $*" >&2
	exit 1
}

usage() {
	cat <<'USAGE'
usage: cageworks-container
  role-enter [--agent|--auth-sock <path>|--signing-key <role>] [--task-dir <path>]
             [--repository <path>] <factory> <role> [cmd...]
  role-worktree <factory> <role> <repo>
  task-file <factory> <workflow> <title> [body]
  factory-prepare <factory> [origin]
  role-stop <factory> <role>
  factory-mirror <factory>
  factory-watch <factory> [--from <id>]
  role-steer <factory> <role> <text>
  factory-send <factory> <json>
  factory-roles <factory>
USAGE
}


## Everything a role session is given beyond an ordinary one, as flags on
## nixcage's own entry point. Each was a special case inside the cage before
## the split; naming them is what let the cage stop knowing what a role is.
##
## The guidance and the task arrive read-only and by bind, and the outcome
## leaves the same way: nothing a role writes ever reaches a command line.
cmd_role_enter() {
	local auth_sock="" task_dir="" signing_role="" from_env="" repository=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--auth-sock)
			auth_sock="${2:-}"
			shift 2
			;;
		--agent)
			from_env=1
			shift
			;;
		--task-dir)
			task_dir="${2:-}"
			shift 2
			;;
		--signing-key)
			signing_role="${2:-}"
			shift 2
			;;
		--repository)
			repository="${2:-}"
			shift 2
			;;
		*) break ;;
		esac
	done

	local factory="${1:-}" role="${2:-}"
	[ -n "$factory" ] && [ -n "$role" ] || {
		usage >&2
		exit 1
	}
	shift 2

	## The operator's agent, taken from the environment rather than named on
	## the command line. On macOS the socket lives in the VM and the path is
	## one nothing on the operator's side can spell, so the only place it can
	## be read is here.
	if [ -n "$from_env" ]; then
		[ -n "${SSH_AUTH_SOCK:-}" ] ||
			die "--agent was given but no agent was forwarded"
		auth_sock="$SSH_AUTH_SOCK"
	fi

	## Refused rather than resolved: a silent preference would decide a
	## security property by argument order (ADR-009).
	if [ -n "$auth_sock" ] && [ -n "$signing_role" ]; then
		die "--auth-sock and --signing-key are mutually exclusive"
	fi

	## A role is a principal of nixcage's: it asks for the number, we say for
	## whom. Which number it is, and that it is never handed out again, is not
	## ours to promise.
	##
	## Two numbers, and they are not interchangeable. The base is the block the
	## cage maps, and loop and agent run as it (ADR-035): one principal, one
	## number, and every host file the session touches belongs to it, because
	## ownership is not shifted on the way in.
	local uid
	uid="$(nixcage-container uid "$role")" ||
		die "could not get a uid for role $role"

	## The clone carries the declaration (ADR-020), so it has to exist before
	## anything can be read out of it and the worktree is prepared first.
	## --repository is needed the first time only: after that the clone records
	## where it was cloned from, which is what a clone is.
	local repo worktree declared_cmd
	repo="${repository:-$(factory_repository "$factory")}"
	[ -n "$repo" ] || exit 1
	worktree="$(cmd_role_worktree "$factory" "$role" "$repo")" || exit 1

	## The decider is the machine's own role (ADR-034 point 1): not in the
	## declaration, running the agent in the mode its loop drives.
	if [ "$role" = "$CAGEWORKS_DECIDER" ]; then
		declared_cmd=$'pi\n--mode\nrpc'
	else
		declared_cmd="$(cageworks_factory_role_command \
			"$(factory_declaration "$factory")" "$role")" || exit 1
	fi

	## Where on the factory's bridge this cage is (ADR-037). The plan is the
	## machine's, written by its build from the same declaration the rules
	## were generated from; a role the plan does not place would have no
	## address, and a machine without a plan has no bridge to put it on.
	## A supervised run is the role's cage and takes its place; a person
	## entering while that cage runs joins its network instead, because the
	## place is taken and a second veth of that name would collide with it.
	## nspawn keeps a directory per machine name under /run/systemd/nspawn
	## and refuses a second machine of one name, registered or not, so the
	## hand's cage beside an actor carries a name of its own; it reaches no
	## veth in that mode, so the twelve-character bound does not apply.
	local network cage="$role"
	if [ -n "$signing_role" ]; then
		local address
		address="$(cageworks_bridge_address "$CAGEWORKS_ETC/bridge.json" "$role")" || exit 1
		network="$(cageworks_bridge_placement "$CAGEWORKS_ETC/bridge.json" "$address")"
	else
		network="$(cageworks_cage_network "$CAGEWORKS_ETC/bridge.json" "$role")" || exit 1
		case "$network" in ns:*) cage="$role-hand" ;; esac
	fi

	local -a opts=(
		--uid "$uid"
		--user "$role"
		--home "$STATE_DIR/homes/$factory-$role"
		--network "$network"
		--no-nix-daemon
	)

	## A role's toolchain is the profile the build realised from its devShell
	## (ADR-040), handed in on the front of PATH because a cage has no daemon
	## to enter a devShell with. A role whose build realised none enters with
	## the floor alone (ADR-030).
	local profile
	if profile="$(cageworks_role_profile "$CAGEWORKS_ETC" "$role")"; then
		opts+=(--setenv "NIXCAGE_PATH_PREFIX=$profile/bin")
	fi

	if [ -n "$auth_sock" ]; then
		opts+=(--auth-sock "$auth_sock")
	else
		## A run nobody is watching holds no forwarded agent, so it cannot
		## push, pull a private repository, or authenticate anywhere (ADR-009
		## in this tracker). Said out loud rather than left to the absence of
		## a socket, because an absence is not a decision.
		opts+=(--no-agent)
	fi

	## A role is told the rules it cannot infer from error messages: what it
	## may write, and that the packed-refs permission error on every ref
	## update is expected rather than a failed commit (ADR-010).
	local guidance_line
	while IFS= read -r guidance_line; do
		[ -n "$guidance_line" ] || continue
		opts+=("$guidance_line")
	done < <(cageworks_role_guidance_args "$CAGEWORKS_LIB/role-guidance.md" "$role")

	## A task reaches the session as files rather than as arguments: the brief
	## is read, the outcome is written, and neither ever passes through a
	## command line or a keystroke stream.
	if [ -n "$task_dir" ]; then
		opts+=(
			--bind "$task_dir:/run/cageworks/task"
			--setenv "CAGEWORKS_TASK=/run/cageworks/task"
		)
	fi

	## A run that signs does it with a key belonging to its role, whose only
	## authority is to produce a signature. The session's git identity is the
	## role's outright rather than the operator's with the role appended: a
	## role commits as itself.
	if [ -n "$signing_role" ]; then
		local key signers gitconfig line
		key="$(cageworks_signing_ensure "$STATE_DIR" "$signing_role" "$uid")" ||
			die "could not prepare a signing key for $signing_role"
		signers="$(cageworks_signing_signers "$STATE_DIR")"
		gitconfig="$(cageworks_signing_gitconfig_path "$STATE_DIR" "$signing_role")" || exit 1
		cageworks_signing_gitconfig "$signing_role" >"$gitconfig"
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			opts+=(--bind-ro "$line")
		done < <(cageworks_signing_binds "$key" "$signers" "$gitconfig")

		## A supervised run is an actor (ADR-033): it gets the loop, which is
		## pi's configuration directory with the extension in it (ADR-035
		## point 2), its two credentials as read-only files, and where the bus
		## and the board are. A person entering by hand is not an actor and
		## gets none of this. Refused when a credential is missing, because a
		## session started without one is an actor nobody can reach.
		## Resolved into a variable rather than read from a process
		## substitution, because a refusal has to stop the session and a
		## loop's status is the loop's, not the substitution's.
		local actor_lines actor_line
		actor_lines="$(cageworks_actor_args "$CAGEWORKS_ETC" "$STATE_DIR" "$factory" "$role")" || exit 1
		while IFS= read -r actor_line; do
			[ -n "$actor_line" ] || continue
			opts+=("$actor_line")
		done <<<"$actor_lines"
	fi

	## A supervised run is an actor, and what an actor runs is the factory's
	## to declare and not the executor's to pass (ADR-033): the declaration
	## wins. A person entering by hand is not an actor and runs what they
	## asked, or the cage's shell when they asked nothing. The declared words
	## arrive as argv, one per line, so nothing in them is re-split.
	if [ -n "$signing_role" ] && [ -n "$declared_cmd" ]; then
		local -a declared=()
		local word
		while IFS= read -r word; do
			[ -n "$word" ] || continue
			declared+=("$word")
		done <<<"$declared_cmd"
		set -- "${declared[@]}"
	fi

	## The cage is named after its role alone: nspawn names the cage's veth
	## after the cage, and the bridge's rules are keyed on that name. A hand
	## beside a running actor is the one exception, named above.
	nixcage-container enter "${opts[@]}" \
		"$cage" "$worktree" "$@"
}

## Create or repair a role's worktree and print its path. Separate from
## role-enter because the supervisor prepares a role before it runs anything in
## it, and because entering must not silently create state.
##
## The worktree is taken from the factory's own clone rather than from the
## operator's repository: role ownership needs a filesystem carrying ownership
## and ACLs, and the operator's may not have one (ADR-011).
cmd_role_worktree() {
	local factory="$1" role="$2" repo="$3"
	## A remote is what a machine clones (ADR-032); a path is what a proof
	## puts on the machine itself. Only a path can be checked before git is.
	[[ "$repo" == *://* ]] || [ -d "$repo" ] || die "repository not found: $repo"

	local clone
	clone="$(cageworks_factory_clone_ensure "$STATE_DIR" "$factory" "$repo")" ||
		die "could not prepare the factory clone for $factory"

	## The agent's number rather than the block's base: this uid is only ever
	## an owner, and what opens the repository is the agent (ADR-028).
	local uid
	uid="$(nixcage-container uid "$role")" ||
		die "could not get a uid for role $role"

	## How much a role may hold is the factory's to say; whether that can be
	## enforced at all is the filesystem's, and nixcage answers for it.
	## Read after the clone exists, because the clone is what carries the
	## declaration the quota is stated in. A quota is applied on every
	## preparation rather than at creation (ADR-017), so the first one made
	## before a declaration existed is bound by the next run.
	cageworks_role_worktree_ensure "$STATE_DIR" "$factory" "$role" "$clone" "$uid" \
		"$(factory_limit "$factory" roleQuota "")" ||
		die "could not prepare the worktree for role $role"
}





## File a goal. It enters at the workflow's first stage, which says what
## capability the work needs rather than who has it, so the operator names what
## should happen and nobody names a role.












## What a machine needs to have before a factory can run on it, made once
## and confirmed on every up (ADR-036, roadmap 2.3): bus passwords and the
## ACL, the operator's account and token, the repository, an account and a
## read-only-repository token per role, a read-only token for the decider,
## a label per stage plus blocked and memory, and each role's memory issue.
## Everything reads the declaration the build put on the machine.
cmd_factory_prepare() {
	local factory="${1:-}" origin="${2:-}"
	[ -n "$factory" ] || die "usage: cageworks-container factory-prepare <factory> [origin]"
	cageworks_name_ok "$factory" || die "invalid factory name: $factory"
	local declaration="$CAGEWORKS_ETC/declaration.json"
	[ -f "$declaration" ] || die "this machine carries no declaration at $declaration"

	## The repository's origin, filed for every session the executor starts
	## (ADR-032). Written by rename so a reader never sees half a URL.
	if [ -n "$origin" ]; then
		printf '%s\n' "$origin" >"$STATE_DIR/origin.new" && mv "$STATE_DIR/origin.new" "$STATE_DIR/origin"
	fi

	local user
	while IFS= read -r user; do
		cageworks_bus_ensure_password "$STATE_DIR" "$user" ||
			die "could not make a bus password for $user"
	done < <(cageworks_bus_users "$declaration")
	systemctl restart cageworks-bus-acl.service

	local base owner="operator"
	base="http://$(jq -r .forgejo "$CAGEWORKS_ETC/bridge.json")/api/v1"
	cageworks_forge_ensure_user operator "operator@$factory.invalid" --admin ||
		die "could not make the operator's account"
	cageworks_forge_ensure_token "$STATE_DIR" operator all ||
		die "could not mint the operator's token"
	local operator
	operator="$(cageworks_forge_token_path "$STATE_DIR" operator)"
	cageworks_forge_ensure_repository "$base" "$operator" "$owner" "$factory" ||
		die "could not make the repository $owner/$factory"

	local label
	while IFS= read -r label; do
		[ -n "$label" ] || continue
		cageworks_forge_ensure_label "$base" "$operator" "$owner" "$factory" "$label" ||
			die "could not make the label $label"
	done < <(jq -r '[.workflows[].stages[].needs] + ["blocked", "memory"] | unique | .[]' "$declaration")

	local role
	while IFS= read -r role; do
		cageworks_forge_ensure_user "$role" "$role@$factory.invalid" ||
			die "could not make an account for role $role"
		cageworks_forge_ensure_reader "$base" "$operator" "$owner" "$factory" "$role" ||
			die "could not give role $role read on the repository"
		cageworks_forge_ensure_token "$STATE_DIR" "$role" write:issue ||
			die "could not mint a token for role $role"
		cageworks_forge_ensure_memory "$base" "$operator" \
			"$(cageworks_forge_token_path "$STATE_DIR" "$role")" "$owner" "$factory" "$role" ||
			die "could not open the memory issue for role $role"
		cage_owns_credentials "$role"
	done < <(jq -r '.roles | keys[]' "$declaration")

	cageworks_forge_ensure_user "$CAGEWORKS_DECIDER" "$CAGEWORKS_DECIDER@$factory.invalid" ||
		die "could not make the decider's account"
	cageworks_forge_ensure_reader "$base" "$operator" "$owner" "$factory" "$CAGEWORKS_DECIDER" ||
		die "could not give the decider read on the repository"
	cageworks_forge_ensure_token "$STATE_DIR" "$CAGEWORKS_DECIDER" read:issue ||
		die "could not mint the decider's token"
	cage_owns_credentials "$CAGEWORKS_DECIDER"

	## The executor starts every session, and a session started before its
	## credentials are the cage's is one that fails or is deaf, so the
	## executor's unit waits for this mark and is started on it. Written
	## last, and by rename, so that a mark seen is a machine prepared.
	: >"$STATE_DIR/prepared.new" && mv "$STATE_DIR/prepared.new" "$STATE_DIR/prepared"
	systemctl restart cageworks-executor.service
	echo "$factory: prepared"
}

## A cage's bus password and forge token are bound read-only into it, and a
## bind keeps the host's ownership, so both have to be the cage's uid's. The
## decider is a cage like a role's here.
cage_owns_credentials() {
	local cage="$1" uid
	uid="$(nixcage-container uid "$cage")" || die "could not get a uid for $cage"
	chown "$uid" "$(cageworks_bus_dir "$STATE_DIR")/$cage" \
		"$(cageworks_forge_token_path "$STATE_DIR" "$cage")" ||
		die "could not give $cage its credentials"
}

## The operator's interventions, each one entry on the operator stream that
## the executor alone acts on (ADR-039 point 1).
cmd_task_file() {
	local factory="${1:-}" workflow="${2:-}" title="${3:-}" body="${4:-}"
	[ -n "$factory" ] && [ -n "$workflow" ] && [ -n "$title" ] ||
		die "usage: cageworks-container task-file <factory> <workflow> <title> [body]"
	cageworks_name_ok "$factory" || die "invalid factory name: $factory"
	local declaration="$CAGEWORKS_ETC/declaration.json" stage
	stage="$(jq -r --arg w "$workflow" '.workflows[$w].stages[0].needs // empty' "$declaration")"
	[ -n "$stage" ] || die "$factory declares no workflow $workflow"
	local dir
	dir="$(cageworks_operator_filed "$STATE_DIR")"
	printf '%s\n' "$title" >"$dir/title"
	printf '%s\n' "$body" >"$dir/body"
	cageworks_operator_send "$STATE_DIR" "$CAGEWORKS_ETC/bridge.json" \
		"$(jq -cn --arg t "$dir/title" --arg b "$dir/body" --arg s "$stage" \
			'{verb: "file", titleFile: $t, bodyFile: $b, stage: $s}')" || exit 1
	echo "$factory: filed at $stage"
}

cmd_role_stop() {
	local factory="${1:-}" role="${2:-}"
	[ -n "$factory" ] && [ -n "$role" ] || die "usage: cageworks-container role-stop <factory> <role>"
	cageworks_role_name_ok "$role" || die "invalid role name: $role"
	cageworks_operator_send "$STATE_DIR" "$CAGEWORKS_ETC/bridge.json" \
		"$(jq -cn --arg r "$role" '{verb: "stop", role: $r}')" || exit 1
	echo "$factory: stop sent to $role"
}

## The bus as JSONL on stdout, for as long as the caller listens (ADR-039
## point 2). The relay is the factory package's; this only names it.
cmd_factory_watch() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: cageworks-container factory-watch <factory> [--from <id>]"
	shift
	exec cageworks-relay "$@"
}

cmd_role_steer() {
	local factory="${1:-}" role="${2:-}" text="${3:-}"
	[ -n "$factory" ] && [ -n "$role" ] && [ -n "$text" ] ||
		die "usage: cageworks-container role-steer <factory> <role> <text>"
	cageworks_role_name_ok "$role" || die "invalid role name: $role"
	cageworks_operator_send "$STATE_DIR" "$CAGEWORKS_ETC/bridge.json" \
		"$(jq -cn --arg r "$role" --arg t "$text" '{op: "steer", role: $r, text: $t}')" || exit 1
	echo "$factory: steered $role"
}

## A command in the decider's own vocabulary, from the operator. The executor
## validates it exactly as it validates the decider's.
cmd_factory_send() {
	local factory="${1:-}" json="${2:-}"
	[ -n "$factory" ] && [ -n "$json" ] || die "usage: cageworks-container factory-send <factory> <json>"
	jq -e '.verb | type == "string"' <<<"$json" >/dev/null 2>&1 ||
		die "not a command: $json"
	cageworks_operator_send "$STATE_DIR" "$CAGEWORKS_ETC/bridge.json" "$(jq -c . <<<"$json")" || exit 1
	echo "$factory: sent"
}

## The declared roles, for a client that needs to know them before the bus
## has said anything.
cmd_factory_roles() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: cageworks-container factory-roles <factory>"
	jq -r '.roles | keys[]' "$(factory_declaration "$factory")" | paste -sd' ' -
}

cmd_factory_mirror() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: cageworks-container factory-mirror <factory>"
	cageworks_operator_send "$STATE_DIR" "$CAGEWORKS_ETC/bridge.json" '{"op":"mirror"}' || exit 1
	echo "$factory: mirror requested"
}

main() {
	local cmd="${1:-}"
	shift || true
	case "$cmd" in
	role-enter) cmd_role_enter "$@" ;;
	role-worktree) cmd_role_worktree "$@" ;;
	task-file) cmd_task_file "$@" ;;
	factory-prepare) cmd_factory_prepare "$@" ;;
	role-stop) cmd_role_stop "$@" ;;
	factory-mirror) cmd_factory_mirror "$@" ;;
	factory-watch) cmd_factory_watch "$@" ;;
	role-steer) cmd_role_steer "$@" ;;
	factory-send) cmd_factory_send "$@" ;;
	factory-roles) cmd_factory_roles "$@" ;;
	*)
		usage >&2
		exit 1
		;;
	esac
}

# Allow sourcing without executing (for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
