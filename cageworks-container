#!/usr/bin/env bash
# cageworks-container -- the factory, on the machine the cages are on.
#
# Everything here is about several named workers sharing one repository: roles,
# capabilities, tasks, workflows, stage policies, the record, integration. None
# of it is about a cage. Where a cage is needed this calls nixcage-container,
# which is the whole of what cageworks knows about how one is built (ADR-018).
#
# A real script rather than a Nix string so that shellcheck reads it and the
# bats suite drives it directly. The Nix module wraps it, setting CAGEWORKS_LIB
# to the store directory holding the shell modules it sources.

set -euo pipefail

# Where the shell modules and the role guidance live. Set by the Nix wrapper to
# a store path; the suite points it at the working tree.
CAGEWORKS_LIB="${CAGEWORKS_LIB:-@lib@}"

# shellcheck source=modules/names.sh
. "$CAGEWORKS_LIB/names.sh"
# shellcheck source=modules/role-worktree.sh
. "$CAGEWORKS_LIB/role-worktree.sh"
# shellcheck source=modules/factory-clone.sh
. "$CAGEWORKS_LIB/factory-clone.sh"
# shellcheck source=modules/task-store.sh
. "$CAGEWORKS_LIB/task-store.sh"
# shellcheck source=modules/workflow-config.sh
. "$CAGEWORKS_LIB/workflow-config.sh"
# shellcheck source=modules/record.sh
. "$CAGEWORKS_LIB/record.sh"
# shellcheck source=modules/caps.sh
. "$CAGEWORKS_LIB/caps.sh"
# shellcheck source=modules/signing.sh
. "$CAGEWORKS_LIB/signing.sh"
# shellcheck source=modules/integrate.sh
. "$CAGEWORKS_LIB/integrate.sh"
# shellcheck source=modules/factory-config.sh
. "$CAGEWORKS_LIB/factory-config.sh"
# shellcheck source=modules/schema.sh
. "$CAGEWORKS_LIB/schema.sh"
# shellcheck source=modules/sizes.sh
. "$CAGEWORKS_LIB/sizes.sh"
# shellcheck source=modules/resources.sh
. "$CAGEWORKS_LIB/resources.sh"
# shellcheck source=modules/repo-declaration.sh
. "$CAGEWORKS_LIB/repo-declaration.sh"
# shellcheck source=modules/role-guidance.sh
. "$CAGEWORKS_LIB/role-guidance.sh"
# shellcheck source=modules/journal.sh
. "$CAGEWORKS_LIB/journal.sh"

# The clones, the worktrees, the keys, the tasks. This is the directory nixcage
# mounts its pool at, and it stays there: the storage primitive can only name a
# dataset for a path the pool already covers, so a state root of our own would
# buy a tidier name and cost every factory its datasets (ADR-018).
STATE_DIR="${CAGEWORKS_STATE:-/var/lib/nixcage}"

# The tasks of every declared factory, kept beside the clones they are worked
# in rather than in any repository.
TASKS_ROOT="$STATE_DIR/tasks"

## The declaration a factory is working, read out of its own clone (ADR-020)
## rather than out of a tree somebody rendered.
##
## Kept under the rev it was read from, which does two things at once. Every
## reader below asks for the same declaration and only the first of them pays
## for an evaluation, and which declaration a run used stays answerable
## afterwards by looking at the name of the file. Written by rename, so a
## reader never sees half of one.
factory_declaration() {
	local factory="$1" clone rev dir file
	clone="$(cageworks_factory_clone_path "$STATE_DIR" "$factory")" || return 1
	[ -d "$clone" ] || die "$factory has no clone to read a declaration from"
	rev="$(cageworks_declaration_rev "$clone")" ||
		die "$factory has no commit to read a declaration from"

	dir="$STATE_DIR/declarations/$factory"
	file="$dir/$rev.json"
	if [ ! -f "$file" ]; then
		mkdir -p "$dir"
		cageworks_declaration_read "$clone" >"$file.new" || {
			rm -f "$file.new"
			die "could not read the declaration $factory is working"
		}
		mv "$file.new" "$file"
	fi
	printf '%s\n' "$file"
}

## Where a factory's clone came from. Nothing declares this: a clone records
## where it was cloned from, which is what a clone is.
factory_repository() {
	local factory="$1" clone
	clone="$(cageworks_factory_clone_path "$STATE_DIR" "$factory")" || return 1
	[ -d "$clone" ] || die "$factory has no clone yet"
	git -C "$clone" remote get-url origin
}
# How much of each item each role has been shown. The supervisor's bookkeeping,
# not part of the shared record.
SEEN_ROOT="$STATE_DIR/seen"

die() {
	echo "cageworks-container: $*" >&2
	exit 1
}

usage() {
	cat <<'USAGE'
usage: cageworks-container
  role-enter [--agent|--auth-sock <path>|--signing-key <role>] [--task-dir <path>]
             [--repository <path>] <factory> <role> [cmd...]
  role-worktree <factory> <role> <repo>
  task-run <factory> <id>
  task-file <factory> <workflow> [acceptance]
  task-list <factory> [state]
  task-show <factory> <id>
  task-thread <factory> <id>
  task-answer <factory> <id> approve|reject [reason]
  factory-sync <factory>
  factory-integrate <factory> <commit>
  factory-resume <factory>
  factory-status <factory>
  factory-reports <factory>
USAGE
}

## What a factory may spend, as its own declaration states it and the operator
## capped it before it got here (ADR-020 point 5). A limit nobody stated falls
## back to the one cageworks would have used anyway, so a factory that declares
## no resources still runs.
factory_limit() {
	local factory="$1" field="$2" fallback="$3" value
	value="$(jq -r --arg f "$field" '(.resources[$f] // empty)' \
		"$(factory_declaration "$factory")")" || return 1
	printf '%s\n' "${value:-$fallback}"
}

## Everything a role session is given beyond an ordinary one, as flags on
## nixcage's own entry point. Each was a special case inside the cage before
## the split; naming them is what let the cage stop knowing what a role is.
##
## The guidance and the task arrive read-only and by bind, and the outcome
## leaves the same way: nothing a role writes ever reaches a command line.
cmd_role_enter() {
	local auth_sock="" task_dir="" signing_role="" from_env="" repository=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--auth-sock)
			auth_sock="${2:-}"
			shift 2
			;;
		--agent)
			from_env=1
			shift
			;;
		--task-dir)
			task_dir="${2:-}"
			shift 2
			;;
		--signing-key)
			signing_role="${2:-}"
			shift 2
			;;
		--repository)
			repository="${2:-}"
			shift 2
			;;
		*) break ;;
		esac
	done

	local factory="${1:-}" role="${2:-}"
	[ -n "$factory" ] && [ -n "$role" ] || {
		usage >&2
		exit 1
	}
	shift 2

	## The operator's agent, taken from the environment rather than named on
	## the command line. On macOS the socket lives in the VM and the path is
	## one nothing on the operator's side can spell, so the only place it can
	## be read is here.
	if [ -n "$from_env" ]; then
		[ -n "${SSH_AUTH_SOCK:-}" ] ||
			die "--agent was given but no agent was forwarded"
		auth_sock="$SSH_AUTH_SOCK"
	fi

	## Refused rather than resolved: a silent preference would decide a
	## security property by argument order (ADR-009).
	if [ -n "$auth_sock" ] && [ -n "$signing_role" ]; then
		die "--auth-sock and --signing-key are mutually exclusive"
	fi

	## A role is a principal of nixcage's: it asks for the number, we say for
	## whom. Which number it is, and that it is never handed out again, is not
	## ours to promise.
	##
	## Two numbers, and they are not interchangeable. The base is the block the
	## cage maps; the agent's is the one inside it the session runs as, and it
	## is the one every host file the session touches has to belong to, because
	## ownership is not shifted on the way in (ADR-028).
	local uid agent_uid
	uid="$(nixcage-container uid "$role")" ||
		die "could not get a uid for role $role"
	agent_uid="$(nixcage-container uid "$role" "$(cageworks_agent_subject)")" ||
		die "could not get a uid for the agent of role $role"

	## The clone carries the declaration (ADR-020), so it has to exist before
	## anything can be read out of it and the worktree is prepared first.
	## --repository is needed the first time only: after that the clone records
	## where it was cloned from, which is what a clone is.
	local repo worktree declared_cmd declared_shell
	repo="${repository:-$(factory_repository "$factory")}"
	[ -n "$repo" ] || exit 1
	worktree="$(cmd_role_worktree "$factory" "$role" "$repo")" || exit 1

	declared_cmd="$(cageworks_factory_role_command \
		"$(factory_declaration "$factory")" "$role")" || exit 1
	declared_shell="$(cageworks_factory_role_shell \
		"$(factory_declaration "$factory")" "$role")" || exit 1

	## The base of the block the cage maps, and the subject inside it the
	## session runs as. Two different numbers: nixcage adds the subject's
	## offset to the base itself, so passing the subject's own number here
	## would map a block starting one past this role's (ADR-028).
	local -a opts=(
		--uid "$uid"
		--user "$role"
		--subject "$(cageworks_agent_subject)"
		--home "$STATE_DIR/homes/$factory-$role"
	)

	## A role's toolchain comes from its declaration for the same reason its
	## command does: what a specialist has to hand is a property of the
	## factory, not of whoever started the session.
	if [ -n "$declared_shell" ]; then
		opts+=(--shell "$declared_shell")
	fi

	if [ -n "$auth_sock" ]; then
		opts+=(--auth-sock "$auth_sock")
	else
		## A run nobody is watching holds no forwarded agent, so it cannot
		## push, pull a private repository, or authenticate anywhere (ADR-009
		## in this tracker). Said out loud rather than left to the absence of
		## a socket, because an absence is not a decision.
		opts+=(--no-agent)
	fi

	## Every session can reach the journal its factory writes, because the
	## ledger is what a role did and a role that is not recorded is one
	## nothing can be checked against (ADR-027 point 5). The socket is a bind
	## and nothing more, which is why this needs nothing new from nixcage.
	local journal_line
	while IFS= read -r journal_line; do
		[ -n "$journal_line" ] || continue
		opts+=("$journal_line")
	done < <(cageworks_journal_args "$factory")

	## A role is told the rules it cannot infer from error messages: what it
	## may write, and that the packed-refs permission error on every ref
	## update is expected rather than a failed commit (ADR-010).
	local guidance_line
	while IFS= read -r guidance_line; do
		[ -n "$guidance_line" ] || continue
		opts+=("$guidance_line")
	done < <(cageworks_role_guidance_args "$CAGEWORKS_LIB/role-guidance.md" "$role")

	## A task reaches the session as files rather than as arguments: the brief
	## is read, the outcome is written, and neither ever passes through a
	## command line or a keystroke stream.
	if [ -n "$task_dir" ]; then
		opts+=(
			--bind "$task_dir:/run/cageworks/task"
			--setenv "CAGEWORKS_TASK=/run/cageworks/task"
		)
	fi

	## A run that signs does it with a key belonging to its role, whose only
	## authority is to produce a signature. The session's git identity is the
	## role's outright rather than the operator's with the role appended: a
	## role commits as itself.
	if [ -n "$signing_role" ]; then
		local key signers gitconfig line
		key="$(cageworks_signing_ensure "$STATE_DIR" "$signing_role" "$agent_uid")" ||
			die "could not prepare a signing key for $signing_role"
		signers="$(cageworks_signing_signers "$STATE_DIR")"
		gitconfig="$(cageworks_signing_gitconfig_path "$STATE_DIR" "$signing_role")" || exit 1
		cageworks_signing_gitconfig "$signing_role" >"$gitconfig"
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			opts+=(--bind-ro "$line")
		done < <(cageworks_signing_binds "$key" "$signers" "$gitconfig")
	fi

	## The declaration wins over anything the caller passes, because what a
	## role runs is a property of the factory and not of whoever started it.
	## It arrives as argv words, one per line, so nothing in it is re-split.
	if [ -n "$declared_cmd" ]; then
		local -a declared=()
		local word
		while IFS= read -r word; do
			[ -n "$word" ] || continue
			declared+=("$word")
		done <<<"$declared_cmd"
		set -- "${declared[@]}"
	fi

	nixcage-container enter "${opts[@]}" \
		"$factory-$role" "$worktree" "$@"
}

## Create or repair a role's worktree and print its path. Separate from
## role-enter because the supervisor prepares a role before it runs anything in
## it, and because entering must not silently create state.
##
## The worktree is taken from the factory's own clone rather than from the
## operator's repository: role ownership needs a filesystem carrying ownership
## and ACLs, and the operator's may not have one (ADR-011).
cmd_role_worktree() {
	local factory="$1" role="$2" repo="$3"
	[ -d "$repo" ] || die "repository not found: $repo"

	local clone
	clone="$(cageworks_factory_clone_ensure "$STATE_DIR" "$factory" "$repo")" ||
		die "could not prepare the factory clone for $factory"

	## The agent's number rather than the block's base: this uid is only ever
	## an owner, and what opens the repository is the agent (ADR-028).
	local uid
	uid="$(nixcage-container uid "$role" "$(cageworks_agent_subject)")" ||
		die "could not get a uid for the agent of role $role"

	## How much a role may hold is the factory's to say; whether that can be
	## enforced at all is the filesystem's, and nixcage answers for it.
	## Read after the clone exists, because the clone is what carries the
	## declaration the quota is stated in. A quota is applied on every
	## preparation rather than at creation (ADR-017), so the first one made
	## before a declaration existed is bound by the next run.
	cageworks_role_worktree_ensure "$STATE_DIR" "$factory" "$role" "$clone" "$uid" \
		"$(factory_limit "$factory" roleQuota "")" ||
		die "could not prepare the worktree for role $role"
}

## Every role that could take a task at this stage, in declaration order. A
## stage nothing can work is a declaration mistake and is refused where it is
## read rather than when a task reaches it (ADR-015).
stage_roles() {
	local factory="$1" workflow="$2" stage="$3"
	local capability roles
	capability="$(cageworks_workflow_stage_needs \
		"$(factory_declaration "$factory")" "$workflow" "$stage")" ||
		die "$workflow stage $stage declares no capability"
	roles="$(cageworks_factory_roles_providing "$(factory_declaration "$factory")" "$capability")"
	[ -n "$roles" ] ||
		die "no role of $factory provides $capability, which $workflow stage $stage needs"
	printf '%s\n' "$roles"
}

## A role is busy while it holds a task: one worktree, one branch, one task at a
## time. Blocked counts as busy because nothing switched branches when the task
## blocked.
role_busy() {
	local factory="$1" role="$2" id state
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		[ "$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" role)" = "$role" ] || continue
		state="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" state)"
		case "$state" in
		running | blocked) return 0 ;;
		esac
	done < <(cageworks_task_list "$TASKS_ROOT" "$factory")
	return 1
}

## Who works a task. A task already taken answers with its taker, however busy
## it is: the branch is in that role's namespace and no peer can write it. An
## untaken one resolves its stage's capability to the first idle role providing
## it, in declaration order, so a factory replays the same way twice (ADR-015).
resolve_taker() {
	local factory="$1" id="$2"
	local taken workflow stage role
	taken="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" role)"
	if [ -n "$taken" ]; then
		echo "$taken"
		return 0
	fi
	workflow="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" workflow)"
	stage="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" stage)"
	## Resolved into a variable rather than read from a process substitution:
	## an undeclared capability has to fail here with its own message, and
	## inside a subshell it would look like every role being busy instead.
	local candidates
	candidates="$(stage_roles "$factory" "$workflow" "$stage")" || exit 1
	while IFS= read -r role; do
		[ -n "$role" ] || continue
		role_busy "$factory" "$role" && continue
		echo "$role"
		return 0
	done <<<"$candidates"
	return 1
}

## The fields a stage requires before it will take a task, defaulting to the
## acceptance criteria: a task nobody stated a finish line for is not work
## anyone can judge.
stage_ready_fields() {
	local factory="$1" workflow="$2" stage="$3" fields
	fields="$(cageworks_workflow_stage_ready \
		"$(factory_declaration "$factory")" "$workflow" "$stage")"
	[ -n "$fields" ] || fields=acceptance
	printf '%s\n' "$fields"
}

## File a goal. It enters at the workflow's first stage, which says what
## capability the work needs rather than who has it, so the operator names what
## should happen and nobody names a role.
cmd_task_file() {
	local factory="$1" workflow="$2" acceptance="${3:-}"
	local entry stage field
	entry="$(cageworks_workflow_entry "$(factory_declaration "$factory")" "$workflow")" || exit 1
	stage="${entry%% *}"
	stage_roles "$factory" "$workflow" "$stage" >/dev/null || exit 1

	local id
	id="$(cageworks_task_new "$TASKS_ROOT" "$factory" "$workflow" "$stage")" ||
		die "could not file a task for $workflow"
	if [ -n "$acceptance" ]; then
		cageworks_task_set "$TASKS_ROOT" "$factory" "$id" acceptance "$acceptance"
	fi

	## Every task opens an item in the shared record, so there is one place the
	## discussion of this work accumulates (ADR-013). The clone must exist
	## first; filing is the operator's act, so it is made here rather than
	## waiting for a role to run.
	local repo clone item
	repo="$(factory_repository "$factory")" || exit 1
	clone="$(cageworks_factory_clone_ensure "$STATE_DIR" "$factory" "$repo")" || exit 1
	item="$(printf '%s\n\n%s\n' "$id" "$acceptance" |
		cageworks_record_new "$clone" supervisor)"
	[ -n "$item" ] && cageworks_task_set "$TASKS_ROOT" "$factory" "$id" item "$item"
	## What a stage requires before it will take work is the stage's to state.
	## A task missing one of those fields stays proposed and says which, rather
	## than being taken and failing inside a cage.
	local -a required=()
	while IFS= read -r field; do
		[ -n "$field" ] || continue
		required+=("$field")
	done < <(stage_ready_fields "$factory" "$workflow" "$stage")
	cageworks_task_ready "$TASKS_ROOT" "$factory" "$id" "${required[@]}" >/dev/null || true
	echo "$id"
}

cmd_task_list() {
	local factory="$1" want="${2:-}"
	local id
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		printf '%s\t%s\t%s\n' "$id" \
			"$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" state)" \
			"$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" role)"
	done < <(cageworks_task_list "$TASKS_ROOT" "$factory" "$want")
}

## Move settled work to the next stage, or finish it. Used when a stage has no
## gate, and again when a gate is approved, so the two paths cannot drift apart.
advance_work() {
	local factory="$1" id="$2" clone="$3" item="$4"
	local workflow stage next child child_item seed
	workflow="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" workflow)"
	stage="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" stage)"
	next="$(cageworks_workflow_next "$(factory_declaration "$factory")" "$workflow" "$stage")"

	if [ -n "$next" ]; then
		child="$(cageworks_task_advance "$TASKS_ROOT" "$factory" "$id" \
			"${next%% *}")" || die "$id: could not advance the work"
		local -a required=()
		local field
		while IFS= read -r field; do
			[ -n "$field" ] || continue
			required+=("$field")
		done < <(stage_ready_fields "$factory" "$workflow" "${next%% *}")
		cageworks_task_ready "$TASKS_ROOT" "$factory" "$child" "${required[@]}" >/dev/null || true
		if [ -n "$item" ]; then
			seed="$STATE_DIR/runs/$factory/$id/seed"
			mkdir -p "$(dirname "$seed")"
			{
				printf '%s\n\n' "$child"
				printf 'inherited from %s:\n\n' "$id"
				cageworks_record_show "$clone" "$item"
			} >"$seed"
			child_item="$(cageworks_record_new "$clone" supervisor <"$seed")"
			[ -n "$child_item" ] &&
				cageworks_task_set "$TASKS_ROOT" "$factory" "$child" item "$child_item"
			printf 'settled; %s opened, needing %s\n' "$child" "${next#* }" |
				cageworks_record_comment "$clone" "$item" supervisor
		fi
		echo "$id: settled, $child opened, needing ${next#* }"
	else
		cageworks_task_advance "$TASKS_ROOT" "$factory" "$id" "" ||
			die "$id: could not finish the work"
		[ -n "$item" ] && printf 'settled; the pipeline ends here\n' |
			cageworks_record_comment "$clone" "$item" supervisor
		echo "$id: settled, the pipeline ends here"
	fi
}

## Answer a gate. Approval lets the work move on by the same path a gateless
## stage takes; rejection sends it back with the reason kept.
cmd_task_answer() {
	local factory="$1" id="$2" answer="$3" reason="${4:-}"
	local clone item
	clone="$(cageworks_factory_clone_path "$STATE_DIR" "$factory")" || exit 1
	item="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" item)"

	cageworks_task_answer "$TASKS_ROOT" "$factory" "$id" "$answer" "$reason" || exit 1
	if [ -n "$item" ]; then
		printf '%s: %s\n' "$answer" "${reason:-no reason given}" |
			cageworks_record_comment "$clone" "$item" operator
	fi

	if [ "$answer" = "approve" ]; then
		advance_work "$factory" "$id" "$clone" "$item"
	else
		echo "$id: rejected, back to its role"
	fi
}

## Bring the factory and the operator's repository back into agreement, in the
## only direction each is allowed to move. Divergence stops the factory rather
## than being resolved: rewriting a shared branch is rare and deliberate, and
## continuing on a history that no longer exists is worse than stopping.
cmd_factory_sync() {
	local factory="$1"
	local repo clone shared
	repo="$(factory_repository "$factory")" || exit 1
	clone="$(cageworks_factory_clone_path "$STATE_DIR" "$factory")" || exit 1
	shared="$(cageworks_factory_shared_branch)"
	[ -d "$clone" ] || die "$factory has no clone yet"

	if cageworks_integrate_diverged "$clone" "$repo" "$shared"; then
		cageworks_integrate_halt "$STATE_DIR" "$factory" \
			"the operator's $shared no longer contains what this factory was built on"
		die "$factory halted: $shared has diverged"
	fi

	cageworks_integrate_publish "$clone" "$repo" "$shared" ||
		die "$factory: could not hand $shared to the operator"
	echo "$factory: $shared published"
}

## Advance the shared branch to a commit a role produced, then hand it on.
## Reading nothing: which commit is the reviewer's judgement, made in a cage;
## moving a ref to a named commit is this, made outside one.
cmd_factory_integrate() {
	local factory="$1" commit="$2"
	local clone shared
	clone="$(cageworks_factory_clone_path "$STATE_DIR" "$factory")" || exit 1
	shared="$(cageworks_factory_shared_branch)"
	cageworks_integrate_advance "$clone" "$shared" "$commit" ||
		die "$factory: $commit does not fast-forward $shared"
	cmd_factory_sync "$factory"
}

cmd_factory_resume() {
	local factory="$1"
	cageworks_integrate_resume "$STATE_DIR" "$factory"
	echo "$factory: resumed"
}

## What roles have raised for the operator. The same mechanism a role uses to
## ask another role, pointed at the one participant who is not a role, so there
## is one way to ask for attention rather than two.
cmd_factory_reports() {
	local factory="$1"
	local clone item
	clone="$(cageworks_factory_clone_path "$STATE_DIR" "$factory")" || exit 1
	[ -d "$clone" ] || return 0
	while IFS= read -r item; do
		[ -n "$item" ] || continue
		printf '%s\t%s\n' "${item:0:8}" \
			"$(cageworks_record_show "$clone" "$item" | head -1)"
	done < <(cageworks_record_needing "$clone" operator)
}

cmd_factory_status() {
	local factory="$1" halted
	if halted="$(cageworks_integrate_halted "$STATE_DIR" "$factory")"; then
		printf 'halted\t%s\n' "$halted"
	else
		printf 'running\t\n'
	fi
}

cmd_task_thread() {
	local factory="$1" id="$2"
	local clone item
	clone="$(cageworks_factory_clone_path "$STATE_DIR" "$factory")" || exit 1
	item="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" item)"
	[ -n "$item" ] || die "$id has no item in the record"
	cageworks_record_show "$clone" "$item"
}

cmd_task_show() {
	local factory="$1" id="$2" field
	for field in state role workflow stage parent item gate attempts acceptance outcome answer; do
		printf '%s\t%s\n' "$field" \
			"$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" "$field")"
	done
}

## Run one task in the cage of whoever takes it. The task is handed in as files
## and the outcome is read back out of one, so nothing about it is ever an
## argument. Every ending is recorded: settled when the role wrote what it did,
## failed when it wrote nothing, crashed, or outlived its limit.
##
## No role is named by the caller: the stage says what the work needs and the
## first idle role providing it takes the task, which is then its for every
## later attempt (ADR-015).
cmd_task_run() {
	local factory="$1" id="$2" role
	local max limit
	max="$(factory_limit "$factory" taskAttempts 3)"
	limit="$(factory_limit "$factory" runTimeoutSeconds 3600)"

	local halted
	if halted="$(cageworks_integrate_halted "$STATE_DIR" "$factory")"; then
		die "$factory is halted: $halted"
	fi

	role="$(resolve_taker "$factory" "$id")" ||
		die "$id: every role that could take this work is busy"
	cageworks_task_take "$TASKS_ROOT" "$factory" "$id" "$role" || exit 1

	local clone item workflow
	clone="$(cageworks_factory_clone_path "$STATE_DIR" "$factory")" || exit 1
	item="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" item)"
	workflow="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" workflow)"

	## The caps are checked before anything is spent, and in this order: the
	## machine before the workflow, because a slot refused costs nothing while
	## a budget charged and then abandoned does not come back. Reaching either
	## stops cleanly and says which one it was.
	local concurrency budget_runs
	concurrency="$(factory_limit "$factory" concurrency 0)"
	budget_runs="$(cageworks_workflow_budget "$(factory_declaration "$factory")" "$workflow" runs)"

	cageworks_cap_claim "$STATE_DIR" "$factory" "$id" "$concurrency" || exit 1
	# shellcheck disable=SC2064
	trap "cageworks_cap_release '$STATE_DIR' '$factory' '$id'" EXIT

	if ! cageworks_cap_spend "$STATE_DIR" "$factory" "$workflow" runs 1 "$budget_runs"; then
		[ -n "$item" ] && printf 'stopped: %s has spent its run budget\n' "$workflow" |
			cageworks_record_comment "$clone" "$item" supervisor
		exit 1
	fi

	cageworks_task_attempt "$TASKS_ROOT" "$factory" "$id" "$max" || exit 1

	## The supervisor writes what it did as it does it, so reading the item top
	## to bottom is the story of the work rather than its ending.
	if [ -n "$item" ]; then
		printf 'attempt %s started for %s\n' \
			"$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" attempts)" "$role" |
			cageworks_record_comment "$clone" "$item" supervisor || true
	fi

	## Declared here rather than inside the brief below: a { } group is not a
	## scope, so an assignment made there would outlive this function.
	local uid run_dir finish own_guidance seen fresh
	uid="$(nixcage-container uid "$role" "$(cageworks_agent_subject)")" ||
		die "could not get a uid for the agent of role $role"
	run_dir="$STATE_DIR/runs/$factory/$id"
	rm -rf "$run_dir"
	mkdir -p "$run_dir"
	{
		printf 'task: %s\n' "$id"
		printf 'role: %s\n' "$role"
		printf 'acceptance:\n%s\n' \
			"$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" acceptance)"
		## What finishing means at this stage, as its declaration states it.
		## Handed over rather than checked: judging whether work meets a bar is
		## reading content, which is what a cage is for (ADR-015).
		finish="$(cageworks_workflow_stage_done "$(factory_declaration "$factory")" \
			"$workflow" "$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" stage)")"
		if [ -n "$finish" ]; then
			printf '\ndone at this stage means:\n%s\n' "$finish"
		fi
		printf '\nbody:\n%s\n' \
			"$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" body)"
		## The conventions of this factory, which the repository carries and
		## the architect maintains. The baseline cageworks ships states
		## properties of the cage; this states how this project works.
		own_guidance="$(cageworks_factory_guidance "$clone")"
		if [ -n "$own_guidance" ]; then
			printf '\nthis factory:\n%s\n' "$own_guidance"
		fi

		## What has already been said about this work. A role opens its turn
		## reading the discussion rather than only the goal, and is told which
		## part of it is new since it last looked -- replaying everything as
		## though it were new is how a record stops being read.
		if [ -n "$item" ]; then
			seen="$(cageworks_record_seen "$SEEN_ROOT" "$factory" "$role" "$item")"
			fresh="$(cageworks_record_since "$clone" "$item" "$seen")"
			printf '\nrecord:\n%s\n' "$(cageworks_record_show "$clone" "$item")"
			if [ -n "$fresh" ]; then
				printf '\nnew since you last looked:\n%s\n' "$fresh"
			else
				printf '\nnew since you last looked:\n  nothing\n'
			fi
			cageworks_record_mark_seen "$SEEN_ROOT" "$factory" "$role" "$item" \
				"$(cageworks_record_count "$clone" "$item")"
		fi
	} >"$run_dir/brief"
	: >"$run_dir/outcome"
	: >"$run_dir/mentions"
	mkdir -p "$run_dir/comments"
	chown "$uid:$uid" "$run_dir/outcome" "$run_dir/mentions" "$run_dir/comments"
	chmod 444 "$run_dir/brief"

	local status=0
	timeout "$limit" "$0" role-enter \
		--task-dir "$run_dir" --signing-key "$role" \
		"$factory" "$role" || status=$?

	## Whatever the role wrote during its turn reaches the record now: it could
	## not write there itself, and this is the boundary where its writing
	## becomes visible to anyone else.
	if [ -n "$item" ]; then
		cageworks_record_ingest "$clone" "$run_dir" "$role" "$item" || true
	fi

	local outcome
	outcome="$(cat "$run_dir/outcome" 2>/dev/null)"
	if [ "$status" = 124 ]; then
		cageworks_task_failed "$TASKS_ROOT" "$factory" "$id" \
			"the run outlived its $limit second limit" "$max"
		[ -n "$item" ] && printf 'the run outlived its %s second limit\n' "$limit" |
			cageworks_record_comment "$clone" "$item" supervisor
		die "$id: run outlived its limit"
	elif [ -n "$outcome" ]; then
		cageworks_task_settle "$TASKS_ROOT" "$factory" "$id" "$outcome" ||
			die "$id: could not record the outcome"

		## A gated stage stops here. The work is done and the hand-off waits on
		## a person, so the task stays awaiting-review rather than moving on,
		## and the slot it held was released when this run ended.
		local stage gate
		stage="$(cageworks_task_get "$TASKS_ROOT" "$factory" "$id" stage)"
		gate="$(cageworks_workflow_stage_gate "$(factory_declaration "$factory")" "$workflow" "$stage")"
		if [ -n "$gate" ]; then
			cageworks_task_gate "$TASKS_ROOT" "$factory" "$id" "$gate" || exit 1
			[ -n "$item" ] && printf 'waiting at the %s gate\n' "$gate" |
				cageworks_record_comment "$clone" "$item" supervisor
			echo "$id: settled, waiting at the $gate gate"
			return 0
		fi

		advance_work "$factory" "$id" "$clone" "$item"
	else
		cageworks_task_failed "$TASKS_ROOT" "$factory" "$id" \
			"the session ended having recorded no outcome" "$max"
		[ -n "$item" ] && printf 'the session ended having recorded no outcome\n' |
			cageworks_record_comment "$clone" "$item" supervisor
		die "$id: no outcome recorded"
	fi
}

main() {
	local cmd="${1:-}"
	shift || true
	case "$cmd" in
	role-enter) cmd_role_enter "$@" ;;
	role-worktree) cmd_role_worktree "$@" ;;
	task-run) cmd_task_run "$@" ;;
	task-file) cmd_task_file "$@" ;;
	task-list) cmd_task_list "$@" ;;
	task-show) cmd_task_show "$@" ;;
	task-thread) cmd_task_thread "$@" ;;
	task-answer) cmd_task_answer "$@" ;;
	factory-sync) cmd_factory_sync "$@" ;;
	factory-integrate) cmd_factory_integrate "$@" ;;
	factory-resume) cmd_factory_resume "$@" ;;
	factory-status) cmd_factory_status "$@" ;;
	factory-reports) cmd_factory_reports "$@" ;;
	*)
		usage >&2
		exit 1
		;;
	esac
}

# Allow sourcing without executing (for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
