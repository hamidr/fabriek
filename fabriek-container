. "$FABRIEK_LIB/in-machine.sh"

# The factory this program acts for (ADR-067): named in the environment by
# the CLI and by every unit, and its facts, the file the host module wrote
# for it, loaded here so that one program serves every factory on the host.
# A test that sets the facts itself names no file and keeps its own.
FABRIEK_FACTORIES="${FABRIEK_FACTORIES:-/etc/fabriek/factories}"
if [ -n "${FABRIEK_FACTORY:-}" ] && [ -f "$FABRIEK_FACTORIES/$FABRIEK_FACTORY.env" ]; then
	set -a
	# shellcheck disable=SC1090  # the host's file for the factory named
	. "$FABRIEK_FACTORIES/$FABRIEK_FACTORY.env"
	set +a
fi

# The clones, the worktrees, the keys, the tasks. This is the directory nixcage
# mounts its pool at, and it stays there: the storage primitive can only name a
# dataset for a path the pool already covers, so a state root of our own would
# buy a tidier name and cost every factory its datasets (ADR-018).
STATE_DIR="${FABRIEK_STATE:-/var/lib/nixcage}"

# What factory-prepare rendered on the machine (ADR-057): the clamped
# declaration, the bridge plan, each role's profile and pi directory. On the
# pool; the image sets the variable, and the suite points it at a scratch
# directory.
FABRIEK_ETC="${FABRIEK_ETC:-/var/lib/fabriek/factory}"


## The declaration a factory is working, read out of its own clone (ADR-020)
## rather than out of a tree somebody rendered.
##
## The declaration this machine was built with (ADR-040): a file the build
## wrote, validated and clamped, and never evaluated here. A machine is one
## factory's, so a request naming another factory is a mistake to say.
factory_declaration() {
	local factory="$1" file="$FABRIEK_ETC/declaration.json" built
	[ -f "$file" ] || die "this machine carries no declaration at $file"
	built="$(jq -r '.name // empty' "$file")"
	[ "$built" = "$factory" ] || die "this machine runs the factory $built, not $factory"
	printf '%s\n' "$file"
}

## One limit out of the declaration's resources, with the caller's default
## when the declaration states none.
factory_limit() {
	local factory="$1" field="$2" default="$3" value
	value="$(jq -r --arg f "$field" '.resources[$f] // empty' "$(factory_declaration "$factory")")" || return 1
	printf '%s\n' "${value:-$default}"
}

## Where a factory's clone came from. Nothing declares this: a clone records
## where it was cloned from, which is what a clone is.
## Where a factory's repository is. The clone records it once it exists;
## before that, the origin fabriek up filed on the machine (ADR-032, ADR-040):
## the executor starts every session, and a session needs no origin on argv.
factory_repository() {
	local factory="$1" clone
	clone="$(fabriek_factory_clone_path "$STATE_DIR" "$factory")" || return 1
	if [ -d "$clone" ]; then
		git -C "$clone" remote get-url origin
	elif [ -s "$STATE_DIR/origin" ]; then
		cat "$STATE_DIR/origin"
	else
		die "$factory has no clone yet, and no origin was filed; run fabriek up"
	fi
}

die() {
	echo "fabriek-container: $*" >&2
	exit 1
}

## This verb, run by the factory's machine rather than here, and its status
## this program's.
exec_in_machine() {
	fabriek_in_machine "$@"
	exit $?
}

usage() {
	cat <<'USAGE'
usage: fabriek-container
  role-enter [--agent|--auth-sock <path>|--signing-key <role>] [--task-dir <path>]
             [--repository <path>] <factory> <role> [cmd...]
  role-worktree <factory> <role> <repo>
  task-file <factory> <workflow> <title> [body]
  factory-render
  factory-prepare <factory> [origin]
  factory-endpoints <factory>
  factory-profiles <factory>
  role-stop <factory> <role> [--now]
  role-transcript <factory> <role> [<session>] [--text]
  factory-mirror <factory>
  factory-up [--update] <factory>
  factory-down <factory>
  factory-status <factory>
  factory-clone <factory>
  factory-declared <factory>
  factory-watch <factory> [--from <id>] [--stream <name>]...
  role-steer <factory> <role> <text>
  factory-send <factory> <json>
  factory-roles <factory>
  factory-board <factory>
  probes-publish [<factory>]
  bus-users [<factory>]
