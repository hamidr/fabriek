#!/usr/bin/env bash
# fabriek-container -- the factory, on the machine the cages are on.
#
# Everything here is about several named workers sharing one repository: roles,
# capabilities, tasks, workflows, stage policies, the record, integration. None
# of it is about a cage. Where a cage is needed this calls nixcage-container,
# which is the whole of what fabriek knows about how one is built (ADR-018).
#
# A real script rather than a Nix string so that shellcheck reads it and the
# bats suite drives it directly. The Nix module wraps it, setting FABRIEK_LIB
# to the store directory holding the shell modules it sources.

set -euo pipefail

# Where the shell modules live. Set by the Nix wrapper to a store path; the
# suite points it at the working tree.
FABRIEK_LIB="${FABRIEK_LIB:-@lib@}"

