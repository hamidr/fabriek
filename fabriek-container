}


## Everything a role session is given beyond an ordinary one, as flags on
## nixcage's own entry point. Each was a special case inside the cage before
## the split; naming them is what let the cage stop knowing what a role is.
##
## The task arrives read-only and by bind, and the outcome leaves the same
## way: nothing a role writes ever reaches a command line. What a role is
## told about the cage is in its system prompt, built into its pi directory
## (ADR-054).
## On the host of a factory in a machine (ADR-070 point 9): the guest plans
## the session where the role's state is, and the host enters it, since only
## the host can compute the closure the cage sees. The plan is checked as
## data from outside the boundary; a hand's agent is added here and never
## named to the guest. stdin is the session's, so the plan's call gets none.
role_enter_on_host() {
	local auth_sock="" from_env="" signing=""
	local -a pass=()
	while [ $# -gt 0 ]; do
		case "$1" in
		--auth-sock)
			auth_sock="${2:-}"
			shift 2
			;;
		--agent)
			from_env=1
			shift
			;;
		--task-dir)
			die "--task-dir is not available to a factory in a machine: a task reaches its role by the bus"
			;;
		--signing-key | --repository)
			[ "$1" = --signing-key ] && signing=1
			pass+=("$1" "${2:-}")
			shift 2
			;;
		*) break ;;
		esac
	done
	if [ -n "$from_env" ]; then
		[ -n "${SSH_AUTH_SOCK:-}" ] || die "--agent was given but no agent was forwarded"
		auth_sock="$SSH_AUTH_SOCK"
	fi
	if [ -n "$auth_sock" ] && [ -n "$signing" ]; then
		die "--auth-sock and --signing-key are mutually exclusive"
	fi
	## A supervised session owns its role's cage, so one already running
	## when it starts is an orphan of an executor that went before it
	## (found on a host 2026-09-25): stopped here, since nixcage refuses an
	## enter under a running cage's name.
	if [ -n "$signing" ] && [ $# -ge 2 ] && fabriek_cage_running "$1-$2"; then
		fabriek_nixcage stop "$1-$2" >/dev/null 2>&1 ||
			die "could not stop $1-$2, which a session before this one left running"
	fi

	## The guest has no origin filed, since up files it here; the checkout it
	## clones is the one the credential names, shared at the same path.
	if [[ " ${pass[*]-} " != *" --repository "* ]]; then
		local checkout
		checkout="$(sed -n 's/^path = "\(.*\)"$/\1/p' "$FABRIEK_ETC/fabriek.toml" 2>/dev/null)"
		[ -z "$checkout" ] || pass+=(--repository "$checkout")
	fi
	local out
	out="$(mktemp)"
	fabriek_in_machine role-enter --plan ${pass[@]+"${pass[@]}"} "$@" </dev/null >"$out" || {
		rm -f "$out"
		die "the machine $FABRIEK_MACHINE could not plan the session"
	}
	local -a plan=()
	mapfile -d '' -t plan <"$out"
	rm -f "$out"
	[ "${#plan[@]}" -gt 0 ] || die "the machine planned nothing"
	fabriek_machine_plan_check "${plan[@]}" || exit 1
	local verb="${plan[0]}"
	plan=("${plan[@]:1}")
	if [ -n "$auth_sock" ] && [ "$verb" = enter ]; then
		mapfile -d '' -t plan < <(fabriek_machine_plan_with_agent "$auth_sock" "${plan[@]}")
	fi
	exec nixcage-container "$verb" --machine "$FABRIEK_MACHINE" "${plan[@]}"
}

## The line role-enter would run, printed NUL after each word instead of
## run, when the host asked for a plan; run otherwise.
role_enter_run() {
	if [ -n "$ROLE_ENTER_PLAN" ]; then
		printf '%s\0' "$@"
		return
	fi
	nixcage-container "$@"
}

cmd_role_enter() {
	if [ -n "${FABRIEK_MACHINE:-}" ]; then
		role_enter_on_host "$@"
	fi
	local auth_sock="" task_dir="" signing_role="" from_env="" repository=""
	ROLE_ENTER_PLAN=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--plan)
			ROLE_ENTER_PLAN=1
			shift
			;;
		--auth-sock)
			auth_sock="${2:-}"
			shift 2
			;;
		--agent)
			from_env=1
			shift
			;;
		--task-dir)
			task_dir="${2:-}"
			shift 2
			;;
		--signing-key)
			signing_role="${2:-}"
			shift 2
			;;
		--repository)
			repository="${2:-}"
			shift 2
			;;
		*) break ;;
		esac
	done

	local factory="${1:-}" role="${2:-}"
	[ -n "$factory" ] && [ -n "$role" ] || {
		usage >&2
		exit 1
	}
	shift 2

	## The operator's agent, taken from the environment rather than named on
	## the command line. On macOS the socket lives in the VM and the path is
	## one nothing on the operator's side can spell, so the only place it can
	## be read is here.
	if [ -n "$from_env" ]; then
		[ -n "${SSH_AUTH_SOCK:-}" ] ||
			die "--agent was given but no agent was forwarded"
		auth_sock="$SSH_AUTH_SOCK"
	fi

	## Refused rather than resolved: a silent preference would decide a
	## security property by argument order (ADR-009).
	if [ -n "$auth_sock" ] && [ -n "$signing_role" ]; then
		die "--auth-sock and --signing-key are mutually exclusive"
	fi

	## A role is a principal of nixcage's: it asks for the number, we say for
	## whom. Which number it is, and that it is never handed out again, is not
	## ours to promise.
	##
	## Two numbers, and they are not interchangeable. The base is the block the
	## cage maps, and loop and agent run as it (ADR-035): one principal, one
	## number, and every host file the session touches belongs to it, because
	## ownership is not shifted on the way in.
	## The cage and its uid's principal are <factory>-<role> (ADR-067 point
	## 3): one host runs several factories, and two roles of one name in
	## two factories are two cages.
	local uid cage="$factory-$role"
	uid="$(nixcage-container uid "$cage")" ||
		die "could not get a uid for role $role"

	## The clone carries the declaration (ADR-020), so it has to exist before
	## anything can be read out of it and the worktree is prepared first.
	## --repository is needed the first time only: after that the clone records
	## where it was cloned from, which is what a clone is.
	local repo worktree declared_cmd
	repo="${repository:-$(factory_repository "$factory")}"
	[ -n "$repo" ] || exit 1
	worktree="$(cmd_role_worktree "$factory" "$role" "$repo")" || exit 1

	## The decider is the machine's own role (ADR-034 point 1): not in the
	## declaration, running the agent the way a role that declares no
	## command does.
	if [ "$role" = "$FABRIEK_DECIDER" ]; then
		declared_cmd=""
	else
		declared_cmd="$(fabriek_factory_role_command \
			"$(factory_declaration "$factory")" "$role")" || exit 1
	fi
	## Only a supervised run is an actor; a person entering by hand runs
	## what they asked and needs no model to have been chosen.
	if [ -n "$signing_role" ] && [ -z "$declared_cmd" ]; then
		declared_cmd="$(fabriek_actor_command "$FABRIEK_ETC" "$role")" || exit 1
	fi

	## Where on the factory's bridge this cage is (ADR-037). The plan is the
	## machine's, written by its build from the same declaration the rules
	## were generated from; a role the plan does not place would have no
	## address, and a machine without a plan has no bridge to put it on.
	## A supervised run is the role's cage and takes its place. A person
	## entering while that cage runs is put inside it (nixcage ADR-012
	## point 4): the same mounts, processes and home the actor has, with
	## the command they asked for or the cage's shell. No agent reaches
	## them there; a hand inside a running actor reads and does not sign.
	if [ -z "$signing_role" ] && fabriek_cage_running "$cage"; then
		if [ $# -gt 0 ]; then
			role_enter_run exec "$cage" -- "$@"
		else
			role_enter_run exec "$cage"
		fi
		return
	fi
	local network
	network="$(fabriek_cage_network "$FABRIEK_ETC/bridge.json" "$role")" || exit 1

	local -a opts=(
		--uid "$uid"
		--user "$role"
		--home "$STATE_DIR/homes/$factory-$role"
		--network "$network"
		--no-nix-daemon
	)

	## What the cage may take of the machine, set on its scope (nixcage
	## ADR-012), sized from the declaration for a supervised run; a hand's
	## own cage is bounded by the machine like before.
	if [ -n "$signing_role" ]; then
		local bound
		while IFS= read -r bound; do
			[ -n "$bound" ] || continue
			opts+=("$bound")
		done < <(fabriek_cage_bounds "$FABRIEK_ETC/declaration.json")
	fi

	## A role's toolchain is the profile the build realised from its devShell
	## (ADR-040), handed in on the front of PATH because a cage has no daemon
	## to enter a devShell with, and named as a store root so the cage sees
	## its closure and nothing else of the store (nixcage ADR-014). A role
	## whose build realised none enters with the floor alone (ADR-030).
	local profile
	if profile="$(fabriek_role_profile "$FABRIEK_ETC" "$role")"; then
		opts+=(--setenv "NIXCAGE_PATH_PREFIX=$profile/bin" --store-root "$profile")
	fi

	## The commit's npm artifacts, fetched at render (ADR-046): npm resolves
	## from them offline and read-only, and writes its logs under the home,
	## since a cage has no route to fetch what the cache lacks.
	local npm_cache
	if npm_cache="$(fabriek_factory_cache "$FABRIEK_ETC" npm)"; then
		opts+=(--store-root "$npm_cache"
			--setenv "npm_config_cache=$npm_cache"
			--setenv "npm_config_offline=true"
			--setenv "npm_config_logs_dir=~/.npm/_logs")
	fi

	if [ -n "$auth_sock" ]; then
		opts+=(--auth-sock "$auth_sock")
	else
		## A run nobody is watching holds no forwarded agent, so it cannot
		## push, pull a private repository, or authenticate anywhere (ADR-009
		## in this tracker). Said out loud rather than left to the absence of
		## a socket, because an absence is not a decision.
		opts+=(--no-agent)
	fi

	## A task reaches the session as files rather than as arguments: the brief
	## is read, the outcome is written, and neither ever passes through a
	## command line or a keystroke stream.
	if [ -n "$task_dir" ]; then
		opts+=(
			--bind "$task_dir:/run/fabriek/task"
			--setenv "FABRIEK_TASK=/run/fabriek/task"
		)
	fi

	## A run that signs does it with a key belonging to its role, whose only
	## authority is to produce a signature. The session's git identity is the
	## role's outright rather than the operator's with the role appended: a
	## role commits as itself.
	if [ -n "$signing_role" ]; then
		local key signers gitconfig line
		key="$(fabriek_signing_ensure "$STATE_DIR" "$signing_role" "$uid")" ||
			die "could not prepare a signing key for $signing_role"
		signers="$(fabriek_signing_signers "$STATE_DIR")"
		gitconfig="$(fabriek_signing_gitconfig_path "$STATE_DIR" "$signing_role")" || exit 1
		fabriek_signing_gitconfig "$signing_role" >"$gitconfig"
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			opts+=(--bind-ro "$line")
		done < <(fabriek_signing_binds "$key" "$signers" "$gitconfig")

		## A supervised run is an actor (ADR-033): it gets the loop, which is
		## pi's configuration directory with the extension in it (ADR-035
		## point 2), its two credentials as read-only files, and where the bus
		## and the board are. A person entering by hand is not an actor and
		## gets none of this. Refused when a credential is missing, because a
		## session started without one is an actor nobody can reach.
		## Resolved into a variable rather than read from a process
		## substitution, because a refusal has to stop the session and a
		## loop's status is the loop's, not the substitution's.
		local actor_lines actor_line
		local scratch
		scratch="$(fabriek_actor_scratch "$role" "$uid")" ||
			die "could not make a pi directory for $role's session"
		actor_lines="$(fabriek_actor_args "$FABRIEK_ETC" "$STATE_DIR" "$factory" "$role" "$scratch")" || exit 1
		while IFS= read -r actor_line; do
			[ -n "$actor_line" ] || continue
			opts+=("$actor_line")
		done <<<"$actor_lines"
	fi

	## A supervised run is an actor, and what an actor runs is the factory's
	## to declare and not the executor's to pass (ADR-033): the declaration
	## wins. A person entering by hand is not an actor and runs what they
	## asked, or the cage's shell when they asked nothing. The declared words
	## arrive as argv, one per line, so nothing in them is re-split.
	if [ -n "$signing_role" ] && [ -n "$declared_cmd" ]; then
		local -a declared=()
		local word
		while IFS= read -r word; do
			[ -n "$word" ] || continue
			declared+=("$word")
		done <<<"$declared_cmd"
		set -- "${declared[@]}"
	fi

	## The cage is named after its role alone: nspawn names the cage's veth
	## after the cage, and the bridge's rules are keyed on that name. A hand
	## beside a running actor is the one exception, named above.
	role_enter_run enter "${opts[@]}" \
		"$cage" "$worktree" "$@"
}

## Create or repair a role's worktree and print its path. Separate from
## role-enter because the supervisor prepares a role before it runs anything in
## it, and because entering must not silently create state.
##
## The worktree is taken from the factory's own clone rather than from the
## operator's repository: role ownership needs a filesystem carrying ownership
## and ACLs, and the operator's may not have one (ADR-011).
cmd_role_worktree() {
	## Where the worktree lives (ADR-070).
	[ -z "${FABRIEK_MACHINE:-}" ] || exec_in_machine role-worktree "$@"
	local factory="$1" role="$2" repo="$3"
	## A remote is what a machine clones (ADR-032); a path is what a proof
	## puts on the machine itself. Only a path can be checked before git is.
	[[ "$repo" == *://* ]] || [ -d "$repo" ] || die "repository not found: $repo"

	local clone
	clone="$(fabriek_factory_clone_ensure "$STATE_DIR" "$factory" "$repo")" ||
		die "could not prepare the factory clone for $factory"

	## The agent's number rather than the block's base: this uid is only ever
	## an owner, and what opens the repository is the agent (ADR-028).
	local uid
	uid="$(nixcage-container uid "$factory-$role")" ||
		die "could not get a uid for role $role"

	## No quota: a factory's roles share its machine's disk (ADR-070).
	fabriek_role_worktree_ensure "$STATE_DIR" "$factory" "$role" "$clone" "$uid" ||
		die "could not prepare the worktree for role $role"
}





## File a goal. It enters at the workflow's first stage, which says what
## capability the work needs rather than who has it, so the operator names what
## should happen and nobody names a role.












## What a machine needs to have before a factory can run on it, made once
## and confirmed on every up (ADR-036, roadmap 2.3): bus passwords and the
## What the machine was handed at boot (ADR-057 point 3), and where render
## puts what it makes of it. Overridable so the suite can hand a machine a
## credential of its own.
FABRIEK_CREDENTIAL="${FABRIEK_CREDENTIAL:-$FABRIEK_ETC/fabriek.toml}"

## The repository at the pin: cloned once as the factory's own clone
## (ADR-032), fetched so the pin is there, and the declaration read from
## that commit and never a working tree (ADR-058). Prints the clone's path.
render_clone() {
	local factory="$1" remote="$2" rev="$3" clone
	clone="$(fabriek_factory_clone_ensure "$STATE_DIR" "$factory" "$remote")" ||
		die "could not clone $remote for $factory"
	git -C "$clone" cat-file -e "$rev^{commit}" 2>/dev/null ||
		git -C "$clone" fetch --quiet origin "$rev" ||
		die "$remote does not have the pinned commit $rev"
	printf '%s\n' "$clone"
}

## The files the services include and the machine program reads, from the
## clamped spec: the declaration, the rev, the notes, the bridge plan, the
## proxy's configuration, the endpoints, the model, the decider's policy
## and directory (modules/factory-render.sh). Written by rename where a
## reader might be mid-read.
render_files() {
	local spec="$1" clone="$2" rev="$3" plan models policy
	mkdir -p "$FABRIEK_ETC/proxy"
	jq -c .declaration "$spec" >"$FABRIEK_ETC/declaration.json.new" &&
		mv "$FABRIEK_ETC/declaration.json.new" "$FABRIEK_ETC/declaration.json"
	printf '%s\n' "$rev" >"$FABRIEK_ETC/rev"
	jq -c .notes "$spec" >"$FABRIEK_ETC/notes.json"
	fabriek_render_bridge_plan "$FABRIEK_ETC/declaration.json" "$FABRIEK_BRIDGE" "$FABRIEK_BRIDGE_HOST" \
		"$FABRIEK_PROXY_PORT" "$FABRIEK_FORGEJO_PORT" "$FABRIEK_BUS_PORT" >"$FABRIEK_ETC/bridge.json" ||
		die "could not place the declaration's roles on the factory's bridge"
	fabriek_render_proxy "$FABRIEK_ETC/declaration.json" >"$FABRIEK_ETC/proxy/endpoints.conf"
	jq -cS '{ credentials: (.egressHeaders // {}), models: (.egressModels // {}), embedder: .embedder }' "$spec" \
		>"$FABRIEK_ETC/endpoints.json"
	fabriek_render_endpoints "$(jq -c '.egressEndpoints // {}' "$spec")" >"$FABRIEK_ETC/endpoint-table.json" ||
		die "could not merge the declared endpoints into the table"
	fabriek_render_model "$FABRIEK_ETC/declaration.json" "$(jq -c '.egressModels // {}' "$spec")" "$(<"$FABRIEK_ETC/endpoint-table.json")" \
		>"$FABRIEK_ETC/model.json" || die "could not choose the model a session starts on"
	policy="$(jq -r '.declaration.decider.policy // empty' "$spec")"
	if [ -n "$policy" ]; then
		git -C "$clone" show "$rev:$policy" >"$FABRIEK_ETC/decider-policy.md" ||
			die "the declaration names a policy at $policy, which the commit $rev does not have"
	else
		rm -f "$FABRIEK_ETC/decider-policy.md"
	fi
	plan="$(jq -r .proxy "$FABRIEK_ETC/bridge.json")"
	models="$(fabriek_render_models "$FABRIEK_ETC/declaration.json" "$plan" "$(<"$FABRIEK_ETC/endpoint-table.json")")" ||
		die "could not point pi at the proxy"
	fabriek_render_decider_dir "$FABRIEK_FLOOR" "$models" "$FABRIEK_ETC/pi-decider"
}

## A profile per role, built by the daemon at the pin and linked beside a pi
## directory composed from the floor (ADR-057 point 5); then profiles.json,
## which is the run's identity with the image and the credential (point 7).
## A role that does not build ends render by name, with no link for it and
## no profiles.json, so no session starts on it.
render_profiles() {
	local clone="$1" rev="$2" role profile models built="{}" specialist_model
	rm -f "$FABRIEK_ETC/profiles.json"
	models="$(fabriek_render_models "$FABRIEK_ETC/declaration.json" "$(jq -r .proxy "$FABRIEK_ETC/bridge.json")" "$(<"$FABRIEK_ETC/endpoint-table.json")")" ||
		die "could not point pi at the proxy"
	while IFS= read -r role; do
		profile="$(fabriek_profile_build "$clone" "$rev" "$FABRIEK_SELF" "$FABRIEK_NIXPKGS" "$FABRIEK_SYSTEM" "$role" "$FABRIEK_ETC/declaration.json" "$FABRIEK_ETC/declared.json" "$FABRIEK_ETC/catalogues")" || {
			rm -f "$FABRIEK_ETC/roles/$role/profile"
			die "could not build a profile for role $role"
		}
		mkdir -p "$FABRIEK_ETC/roles/$role"
		ln -sfn "$profile" "$FABRIEK_ETC/roles/$role/profile"
		fabriek_render_pi_dir "$FABRIEK_FLOOR" "$profile" "$models" "$FABRIEK_ETC/roles/$role/pi" ||
			die "could not compose the pi directory for role $role"
		specialist_model=""
		[ ! -f "$profile/share/fabriek/specialist/model" ] || specialist_model="$(<"$profile/share/fabriek/specialist/model")"
		fabriek_render_role_model "$FABRIEK_ETC/declaration.json" "$FABRIEK_ETC/model.json" "$role" "$specialist_model" \
			>"$FABRIEK_ETC/roles/$role/model" || die "could not choose the model for role $role"
		built="$(jq -c --arg r "$role" --arg p "$profile" '. + {($r): $p}' <<<"$built")"
	done < <(jq -r '.roles | keys[]' "$FABRIEK_ETC/declaration.json")
	jq -cn --arg rev "$rev" --argjson roles "$built" --arg decider "$FABRIEK_ETC/pi-decider" \
		'{ rev: $rev, roles: $roles, decider: $decider }' >"$FABRIEK_ETC/profiles.json"
}

## The repository's dependency caches (ADR-046), built here from the
## lockfiles at the pin and linked where a session's composer finds them;
## one an earlier pin left is unlinked when this one has no lockfile.
render_caches() {
	local clone="$1" rev="$2" cache
	cache="$(fabriek_npm_cache_build "$clone" "$rev" "$FABRIEK_SELF" "$FABRIEK_NIXPKGS" "$FABRIEK_SYSTEM")" ||
		die "could not build the npm cache from package-lock.json at $rev"
	if [ -n "$cache" ]; then
		mkdir -p "$FABRIEK_ETC/cache"
		ln -sfn "$cache" "$FABRIEK_ETC/cache/npm"
	else
		rm -f "$FABRIEK_ETC/cache/npm"
	fi
}

## What the build did, at boot, from the credential (ADR-057 point 4): the
## repository at the pin, its declaration clamped against the caps, the
## files the services include, the bridge's set, the record's bound, a
## profile and a pi directory per role. Idempotent: up runs it after every
## restart. What the clamp changed is said here, as the build's log was not.
cmd_factory_render() {
	[ -n "${FABRIEK_FLOOR:-}" ] && [ -n "${FABRIEK_SELF:-}" ] && [ -n "${FABRIEK_NIXPKGS:-}" ] && [ -n "${FABRIEK_SYSTEM:-}" ] ||
		die "FABRIEK_FLOOR, FABRIEK_SELF, FABRIEK_NIXPKGS and FABRIEK_SYSTEM name the image's floor, source, nixpkgs and system; the machine sets them"
	local credential local_file spec factory remote rev clone declaration
	credential="$(mktemp)"
	fabriek_render_credential "$FABRIEK_CREDENTIAL" >"$credential" || exit 1
	factory="$(jq -r '.factory.name // empty' "$credential")"
	remote="$(jq -r '.repository.remote // empty' "$credential")"
	rev="$(jq -r '.pin.rev // empty' "$credential")"
	[ -n "$factory" ] && [ -n "$remote" ] && [ -n "$rev" ] ||
		die "the credential names no factory, remote or pin"
	fabriek_name_ok "$factory" || die "invalid factory name: $factory"

	clone="$(render_clone "$factory" "$remote" "$rev")" || exit 1
	declaration="$(mktemp)"
	## From the credential when the operator's file declared the factory
	## (ADR-061 point 6), the clone's fabriek.toml at the pin otherwise;
	## the host refused a factory declared in both before the boot.
	if jq -e '.declaration' "$credential" >/dev/null; then
		jq '.declaration' "$credential" | fabriek_declaration_validate >"$declaration" || exit 1
	else
		fabriek_declaration_read "$clone" "$rev" >"$declaration" || exit 1
	fi
	## The operator's specialists, skills and catalogue directories, for
	## the profile builds (ADR-061 points 3 and 4).
	local declared_json catalogues_list
	declared_json="$(jq -c '{specialists: (.specialists // {}), skills: (.skills // {})}' "$credential")"
	## A git catalogue is a table whose path is the store path the host
	## fetched (ADR-062 point 5); nothing else of the table is read here.
	catalogues_list="$(jq -r '(.catalogues // [])[] | if type == "string" then . else .path end' "$credential")"
	local_file="$(mktemp)"
	fabriek_render_local "$credential" >"$local_file"
	spec="$(mktemp)"
	fabriek_machine_spec "$declaration" "$local_file" >"$spec" || exit 1
	jq -c --slurpfile c "$credential" '. + { embedder: $c[0].embedder.url }' "$spec" >"$spec.2" && mv "$spec.2" "$spec"

	mkdir -p "$FABRIEK_ETC"
	printf '%s\n' "$declared_json" >"$FABRIEK_ETC/declared.json"
	printf '%s\n' "$catalogues_list" >"$FABRIEK_ETC/catalogues"
	render_files "$spec" "$clone" "$rev"
	render_profiles "$clone" "$rev"
	render_caches "$clone" "$rev"
	systemctl restart "fabriek-$factory-egress-credentials.service"
	## Reloaded rather than restarted where it can be: a restart drops
	## every connection a cage has open through it, and counts against
	## systemd's start limit.
	systemctl reload nginx.service || systemctl restart nginx.service
	jq -r '.[]' "$FABRIEK_ETC/notes.json"
	rm -f "$credential" "$declaration" "$local_file" "$spec"
	echo "$factory: rendered at $rev"
}

## Which endpoints the rendered factory reaches, one per line: what up asks
## before giving the machine a credential, so one for an endpoint the clamp
## dropped never leaves the host (ADR-025).
cmd_factory_endpoints() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-endpoints <factory>"
	factory_declaration "$factory" >/dev/null
	[ -f "$FABRIEK_ETC/endpoints.json" ] || die "this machine has no rendered endpoints; run fabriek up"
	jq -r '.credentials | keys[]' "$FABRIEK_ETC/endpoints.json"
}

## What render made of the pin: the rev, a profile per role and the
## decider's directory, for up to root on the host and show to print
## (ADR-057 point 7).
cmd_factory_profiles() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-profiles <factory>"
	factory_declaration "$factory" >/dev/null
	[ -f "$FABRIEK_ETC/profiles.json" ] || die "this machine has no profiles rendered; run fabriek up"
	cat "$FABRIEK_ETC/profiles.json"
}

## ACL, the operator's account and token, the repository, an account and a
## read-only-repository token per role, a read-only token for the decider,
## a label per stage plus blocked and memory, and each role's memory issue.
## Everything reads the declaration render put on the machine.
cmd_factory_prepare() {
	local factory="${1:-}" origin="${2:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-prepare <factory> [origin]"
	fabriek_name_ok "$factory" || die "invalid factory name: $factory"
	local declaration="$FABRIEK_ETC/declaration.json"
	[ -f "$declaration" ] || die "this machine carries no declaration at $declaration"

	## The repository's origin, filed for every session the executor starts
	## (ADR-032). Written by rename so a reader never sees half a URL.
	if [ -n "$origin" ]; then
		printf '%s\n' "$origin" >"$STATE_DIR/origin.new" && mv "$STATE_DIR/origin.new" "$STATE_DIR/origin"
	fi

	local user
	while IFS= read -r user; do
		fabriek_bus_ensure_password "$STATE_DIR" "$user" ||
			die "could not make a bus password for $user"
	done < <(fabriek_bus_users "$declaration")
	## The account's users, and the server asked to read them: a role
	## declared since the last up has one from here on, and every other
	## factory's connections are untouched (ADR-069 point 3).
	fabriek_bus_render_users "$factory" "$STATE_DIR" "$FABRIEK_ETC" "$declaration" ||
		die "could not write the bus users for $factory"
	fabriek_bus_reload || die "could not have the bus read $factory's users"

	## The repository's owner is the factory's own account and not an admin
	## (ADR-068 points 2 and 3): its token, the executor's, reaches what this
	## account owns and nothing another account does. Making the account is
	## the instance's admin's, which is root through the forge's CLI; every
	## call after it is the owner's.
	local base owner
	owner="$(fabriek_forge_account "$factory" operator)" || die "invalid factory name: $factory"
	base="http://$(jq -r .forgejo "$FABRIEK_ETC/bridge.json")/api/v1"
	fabriek_forge_ensure_user "$owner" "operator@$factory.invalid" ||
		die "could not make the operator's account"
	fabriek_forge_drop_stale_token "$base" "$STATE_DIR" operator /user
	fabriek_forge_ensure_token "$STATE_DIR" operator "$owner" all ||
		die "could not mint the operator's token"
	local operator
	operator="$(fabriek_forge_token_path "$STATE_DIR" operator)"
	fabriek_forge_ensure_repository "$base" "$operator" "$owner" "$factory" ||
		die "could not make the repository $owner/$factory"

	## The operator's fetch (ADR-070 point 8): with the clone on the
	## machine's disk the checkout's remote is the forge, read with a token
	## that reads and nothing else, readable by the fabriek group.
	if [ -n "${FABRIEK_MACHINE:-}" ]; then
		fabriek_forge_ensure_token "$STATE_DIR" fetch "$owner" read:repository ||
			die "could not mint the operator's fetch token"
		install -m 0640 "$(fabriek_forge_token_path "$STATE_DIR" fetch)" "$FABRIEK_ETC/fetch-token.new" ||
			die "could not file the operator's fetch token"
		chgrp fabriek "$FABRIEK_ETC/fetch-token.new" 2>/dev/null || [ "$EUID" != 0 ] ||
			die "could not give the fetch token to the fabriek group"
		mv "$FABRIEK_ETC/fetch-token.new" "$FABRIEK_ETC/fetch-token"
	fi

	local label
	while IFS= read -r label; do
		[ -n "$label" ] || continue
		fabriek_forge_ensure_label "$base" "$operator" "$owner" "$factory" "$label" ||
			die "could not make the label $label"
	done < <(jq -r '[.workflows[].stages[].needs] + ["assigning", "assigned", "blocked", "memory"] | unique | .[]' "$declaration")

	## main on the forge, once, from the origin the machine knows (ADR-036
	## points 5 and 7). An origin that cannot be reached is said and not
	## fatal, as for the record: the clone will say it again.
	local origin_url
	origin_url="$(factory_repository "$factory" 2>/dev/null)" || origin_url=""
	if [ -n "$origin_url" ]; then
		fabriek_forge_ensure_main "$base" "$operator" "$owner" "$factory" "$origin_url" \
			"$(fabriek_forge_git_url "$FABRIEK_ETC/bridge.json" "$owner" "$factory")" ||
			echo "fabriek-container: could not put main from $origin_url on the forge; a pull request and a mirror need it" >&2
	fi

	## A board with nothing on it is a fresh machine, and origin may carry
	## the record of the one before (ADR-036 point 7). Restored before the
	## memory issues so that the board is the record's and then the roles'.
	## An origin that cannot be reached is said and not fatal: the clone
	## will say it again, and a factory with no record is still a factory.
	if fabriek_forge_board_empty "$base" "$operator" "$owner" "$factory"; then
		local origin_url record
		origin_url="$(factory_repository "$factory" 2>/dev/null)" || origin_url=""
		if [ -n "$origin_url" ]; then
			if record="$(fabriek_record_read "$origin_url")"; then
				[ -z "$record" ] || fabriek_forge_restore_record "$base" "$operator" "$owner" "$factory" "$record" ||
					die "could not restore the record from $origin_url"
			else
				echo "fabriek-container: could not ask $origin_url for the record; the board starts empty" >&2
			fi
		fi
	fi

	## A role's account carries the factory, the name its cage and its bus
	## user already have (ADR-068 point 4); its token file keeps the bare
	## role, because a factory's state holds only its own.
	local role account
	while IFS= read -r role; do
		account="$(fabriek_forge_account "$factory" "$role")" ||
			die "invalid role name: $role"
		fabriek_forge_ensure_user "$account" "$role@$factory.invalid" ||
			die "could not make an account for role $role"
		fabriek_forge_ensure_reader "$base" "$operator" "$owner" "$factory" "$account" ||
			die "could not give role $role read on the repository"
		fabriek_forge_drop_stale_token "$base" "$STATE_DIR" "$role" \
			"/repos/$owner/$factory/issues?limit=1"
		fabriek_forge_ensure_token "$STATE_DIR" "$role" "$account" write:issue ||
			die "could not mint a token for role $role"
		fabriek_forge_ensure_memory "$base" "$operator" \
			"$(fabriek_forge_token_path "$STATE_DIR" "$role")" "$owner" "$factory" "$role" "$account" ||
			die "could not open the memory issue for role $role"
		cage_owns_credentials "$factory" "$role"
	done < <(jq -r '.roles | keys[]' "$declaration")

	account="$(fabriek_forge_account "$factory" "$FABRIEK_DECIDER")" ||
		die "invalid factory name: $factory"
	fabriek_forge_ensure_user "$account" "$FABRIEK_DECIDER@$factory.invalid" ||
		die "could not make the decider's account"
	fabriek_forge_ensure_reader "$base" "$operator" "$owner" "$factory" "$account" ||
		die "could not give the decider read on the repository"
	fabriek_forge_drop_stale_token "$base" "$STATE_DIR" "$FABRIEK_DECIDER" \
		"/repos/$owner/$factory/issues?limit=1"
	fabriek_forge_ensure_token "$STATE_DIR" "$FABRIEK_DECIDER" "$account" read:issue ||
		die "could not mint the decider's token"
	cage_owns_credentials "$factory" "$FABRIEK_DECIDER"

	## The executor starts every session, and a session started before its
	## credentials are the cage's is one that fails or is deaf, so the
	## executor's unit waits for this mark and is started on it. Written
	## last, and by rename, so that a mark seen is a machine prepared; under
	## /run, so a reboot with new credentials is not prepared for the old
	## ones (models/vm-lifecycle.qnt).
	mkdir -p "$(fabriek_run_dir)"
	: >"$(fabriek_run_dir)/prepared.new" && mv "$(fabriek_run_dir)/prepared.new" "$(fabriek_run_dir)/prepared"
	systemctl restart "fabriek-$factory-executor.service"
	## The probes read every factory's declaration to name a cgroup's role
	## and skip one without, which is not a failure their unit restarts on.
	if [ -n "${FABRIEK_MACHINE:-}" ]; then
		## The probes are the machine's (ADR-070 point 7).
		nixcage-container machine exec "$FABRIEK_MACHINE" systemctl restart fabriek-probes.service ||
			echo "fabriek-container: could not restart the probes in $factory's machine" >&2
	else
		systemctl restart fabriek-probes.service
	fi
	echo "$factory: prepared"
}

## A cage's bus password and forge token are bound read-only into it, and a
## bind keeps the host's ownership, so both have to be the cage's uid's. The
## decider is a cage like a role's here.
cage_owns_credentials() {
	local factory="$1" cage="$2" uid
	uid="$(fabriek_nixcage uid "$factory-$cage")" || die "could not get a uid for $cage"
	chown "$uid" "$(fabriek_bus_dir "$STATE_DIR")/$cage" \
		"$(fabriek_forge_token_path "$STATE_DIR" "$cage")" ||
		die "could not give $cage its credentials"
}

## The operator's interventions, each one entry on the operator stream that
## the executor alone acts on (ADR-039 point 1).
cmd_task_file() {
	local factory="${1:-}" workflow="${2:-}" title="${3:-}" body="${4:-}"
	[ -n "$factory" ] && [ -n "$workflow" ] && [ -n "$title" ] ||
		die "usage: fabriek-container task-file <factory> <workflow> <title> [body]"
	fabriek_name_ok "$factory" || die "invalid factory name: $factory"
	local declaration="$FABRIEK_ETC/declaration.json" stage
	stage="$(jq -r --arg w "$workflow" '.workflows[$w].stages[0].needs // empty' "$declaration")"
	[ -n "$stage" ] || die "$factory declares no workflow $workflow"
	local dir
	dir="$(fabriek_operator_filed "$STATE_DIR")"
	printf '%s\n' "$title" >"$dir/title"
	printf '%s\n' "$body" >"$dir/body"
	fabriek_operator_send "$factory" "$STATE_DIR" "$FABRIEK_ETC/bridge.json" \
		"$(jq -cn --arg t "$dir/title" --arg b "$dir/body" --arg s "$stage" \
			'{verb: "file", titleFile: $t, bodyFile: $b, stage: $s}')" || exit 1
	echo "$factory: filed at $stage"
}

## A stop goes through the executor, which ends the turn and keeps the
## task with the role. --now ends the cage itself at its scope (nixcage
## ADR-012), for a turn that no longer answers the bus.
cmd_role_stop() {
	local factory="${1:-}" role="${2:-}" now=""
	[ "${3:-}" = "--now" ] && now=1
	[ -n "$factory" ] && [ -n "$role" ] || die "usage: fabriek-container role-stop <factory> <role> [--now]"
	fabriek_role_name_ok "$role" || die "invalid role name: $role"
	if [ -n "$now" ]; then
		fabriek_nixcage stop "$factory-$role" || exit 1
		echo "$factory: $role stopped at its scope"
		return
	fi
	fabriek_operator_send "$factory" "$STATE_DIR" "$FABRIEK_ETC/bridge.json" \
		"$(jq -cn --arg r "$role" '{verb: "stop", role: $r}')" || exit 1
	echo "$factory: stop sent to $role"
}

## A role's sessions as pi kept them in its home, read-only.
cmd_role_transcript() {
	## Read where the role's home is (ADR-070).
	[ -z "${FABRIEK_MACHINE:-}" ] || exec_in_machine role-transcript "$@"
	local factory="${1:-}" role="${2:-}"
	[ -n "$factory" ] && [ -n "$role" ] || die "usage: fabriek-container role-transcript <factory> <role> [<session>] [--text]"
	shift 2
	fabriek_name_ok "$factory" || die "invalid factory name: $factory"
	fabriek_role_name_ok "$role" || die "invalid role name: $role"
	fabriek_transcript "$STATE_DIR" "$factory" "$role" "$@"
}

## The bus as JSONL on stdout, for as long as the caller listens (ADR-039
## point 2). The relay is the factory package's; this only names it.
cmd_factory_watch() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-watch <factory> [--from <id>] [--stream <name>]..."
	shift
	exec fabriek-relay "$@"
}

cmd_role_steer() {
	local factory="${1:-}" role="${2:-}" text="${3:-}"
	[ -n "$factory" ] && [ -n "$role" ] && [ -n "$text" ] ||
		die "usage: fabriek-container role-steer <factory> <role> <text>"
	fabriek_role_name_ok "$role" || die "invalid role name: $role"
	fabriek_operator_send "$factory" "$STATE_DIR" "$FABRIEK_ETC/bridge.json" \
		"$(jq -cn --arg r "$role" --arg t "$text" '{op: "steer", role: $r, text: $t}')" || exit 1
	echo "$factory: steered $role"
}

## A command in the decider's own vocabulary, from the operator. The executor
## validates it exactly as it validates the decider's.
cmd_factory_send() {
	local factory="${1:-}" json="${2:-}"
	[ -n "$factory" ] && [ -n "$json" ] || die "usage: fabriek-container factory-send <factory> <json>"
	jq -e '.verb | type == "string"' <<<"$json" >/dev/null 2>&1 ||
		die "not a command: $json"
	fabriek_operator_send "$factory" "$STATE_DIR" "$FABRIEK_ETC/bridge.json" "$(jq -c . <<<"$json")" || exit 1
	echo "$factory: sent"
}

## The declared roles, for a client that needs to know them before the bus
## has said anything.
cmd_factory_roles() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-roles <factory>"
	jq -r '.roles | keys[]' "$(factory_declaration "$factory")" | paste -sd' ' -
}

## The board's address on the bridge and a fresh password for the operator's
## account, for the one thing no verb does: merging, in Forgejo's UI
## (ADR-036). The account was made with a password nothing kept, so one is
## set each time and printed once, to the operator's terminal and nowhere
## else. The address first, the password second, one per line.
cmd_factory_board() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-board <factory>"
	factory_declaration "$factory" >/dev/null
	local password
	password="$(fabriek_secret)"
	fabriek_forge_admin user change-password --username "$(fabriek_forge_account "$factory" operator)" \
		--password "$password" --must-change-password=false >/dev/null 2>&1 ||
		die "could not set the operator's password on the board"
	jq -r .forgejo "$FABRIEK_ETC/bridge.json"
	printf '%s\n' "$password"
}

## The factory this machine runs, from the declaration prepare rendered;
## the caller may name it to have it checked. Before prepare there is none,
## which is a machine with nothing to apply yet and not a fault: the units
## that call these at boot are restarted by prepare.
prepared_declaration() {
	local factory="${1:-}" file="$FABRIEK_ETC/declaration.json"
	if [ ! -f "$file" ]; then
		echo "fabriek-container: no factory prepared yet at $file" >&2
		return 1
	fi
	if [ -n "$factory" ]; then
		factory_declaration "$factory"
	else
		printf '%s\n' "$file"
	fi
}

## Who may say what on the bus, applied from the password files prepare
## wrote (ADR-033 point 3). The machine's ACL unit runs this at boot and
## prepare restarts that unit after writing a new password.
## The account's users, written where the host's configuration includes
## them and read at the server's next reload (ADR-069 point 3). Nothing
## here speaks to a running server.
cmd_bus_users() {
	local factory="${1:-$FABRIEK_FACTORY}" declaration
	declaration="$(prepared_declaration "${1:-}")" || exit 0
	fabriek_bus_render_users "$factory" "$STATE_DIR" "$FABRIEK_ETC" "$declaration" ||
		die "could not write the bus users for $factory"
	fabriek_bus_reload || die "could not have the bus read $factory's users"
}

## The kernel's lines, from bpftrace on stdin, onto the bus with the role
## each uid belongs to (ADR-038 point 3).
## One reader for the host, over every factory's facts (ADR-067).
cmd_probes_publish() {
	fabriek_probes_publish "$FABRIEK_FACTORIES"
}

cmd_factory_mirror() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-mirror <factory>"
	fabriek_operator_send "$factory" "$STATE_DIR" "$FABRIEK_ETC/bridge.json" '{"op":"mirror"}' || exit 1
	echo "$factory: mirror requested"
}

## Whether the factory named is the one this program was given facts
## for. A factory the host does not declare has no units to start.
factory_declared() {
	local factory="$1"
	[ "$factory" = "${FABRIEK_FACTORY:-}" ] && [ -f "$FABRIEK_FACTORIES/$factory.env" ]
}

## fabriek up on the host (ADR-067, models/factory-lifecycle.qnt): under a
## lock on the factory's directory held for the whole run, so the unit at
## boot and a hand never render at once and the pin never moves under an
## up in flight: the credential written for this pin, the units started,
## the checkout cloned and rendered, the model credentials filed, the
## forge and the bus prepared, the mark written last.
cmd_factory_up() {
	local update="" factory="" arg
	for arg in "$@"; do
		case "$arg" in
		-u | --update) update=1 ;;
		-*) die "usage: fabriek-container factory-up [--update] <factory>" ;;
		*) factory="$arg" ;;
		esac
	done
	[ -n "$factory" ] || die "usage: fabriek-container factory-up [--update] <factory>"
	fabriek_name_ok "$factory" || die "invalid factory name: $factory"
	factory_declared "$factory" || die "$factory is not declared on this host; a factory is services.fabriek.factories.<name>"

	mkdir -p "$FABRIEK_ETC"
	exec 8>"$FABRIEK_ETC/up.lock"
	flock -w "${FABRIEK_UP_LOCK_WAIT:-600}" 8 ||
		die "another up holds $factory; waited ${FABRIEK_UP_LOCK_WAIT:-600}s for it"

	local path
	path="$(fabriek_up_credential "$factory" "$FABRIEK_ETC" "$update" "$FABRIEK_SYSTEM")" || exit 1

	## The state unit makes the datasets render writes into, so it is
	## started before render and is the only unit of the factory's own
	## that up starts: the board and the bus are the host's (ADR-068,
	## ADR-069), and prepare tells each what this factory is.
	systemctl start "fabriek-$factory-state.service" || die "could not start $factory's state"

	cmd_factory_render
	fabriek_up_secrets "$factory" "$STATE_DIR" "$FABRIEK_ETC/endpoints.json" || exit 1
	## The factory's machine (ADR-070), ready before prepare asks it for
	## the uids its credentials are given to and before any session.
	if [ -n "${FABRIEK_MACHINE:-}" ]; then
		nixcage-container machine up "$FABRIEK_MACHINE" || die "could not bring up $factory's machine"
	fi
	cmd_factory_prepare "$factory" "$path"
}

## fabriek down: refused while a role's cage runs, since ADR-017 exists
## because a factory was ended rather than stopped; then the executor,
## then the units in reverse, and the mark gone so nothing starts on a
## factory that is not prepared. The datasets stay.
## The first of the factory's declared roles whose cage runs, and failure
## when none does. nixcage answers "stopped" with success, so the word is
## read (fabriek_cage_running), never the exit code.
factory_role_running() {
	local factory="$1" role
	while IFS= read -r role; do
		if fabriek_cage_running "$factory-$role"; then
			echo "$role"
			return 0
		fi
	done < <(jq -r '.roles | keys[]' "$FABRIEK_ETC/declaration.json")
	return 1
}

cmd_factory_down() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-down <factory>"
	factory_declared "$factory" || die "$factory is not declared on this host"
	## The executor starts a session for every role and they end with it,
	## so it goes first, and their scopes are gone by the time its stop
	## returns. A cage still running after that is one a hand entered
	## outside the executor, and that is reported, never forced (PRD-004):
	## the executor stays down and the rest stays up until the hand is out
	## and down is asked again.
	systemctl stop "fabriek-$factory-executor.service" || true
	if [ -f "$FABRIEK_ETC/declaration.json" ]; then
		local running
		if running="$(factory_role_running "$factory")"; then
			die "$factory's role $running is still running; stop it first, or fabriek stop $running"
		fi
	fi
	rm -f "$(fabriek_run_dir)/prepared"
	## The machine last, once nothing of the factory runs in it (ADR-070).
	if [ -n "${FABRIEK_MACHINE:-}" ]; then
		nixcage-container machine down "$FABRIEK_MACHINE" || die "could not stop $factory's machine"
	fi
	echo "$factory has stopped"
}

## Where the factory's clone is, for the remote the CLI adds to the
## operator's checkout (ADR-067 point 5).
cmd_factory_clone() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-clone <factory>"
	## In a machine the clone is on a disk this host does not read, so what
	## the CLI fetches is the forge's repository and the token that reads it
	## (ADR-070 point 8), one per line.
	if [ -n "${FABRIEK_MACHINE:-}" ]; then
		fabriek_name_ok "$factory" || die "invalid factory name: $factory"
		fabriek_forge_git_url "$FABRIEK_ETC/bridge.json" "$(fabriek_forge_account "$factory" operator)" "$factory"
		printf '%s\n' "$FABRIEK_ETC/fetch-token"
		return
	fi
	fabriek_factory_clone_path "$STATE_DIR" "$factory" || die "invalid factory name: $factory"
}

## Which file declared the factory (ADR-061 point 6): the operator's own
## when the credential carries a declaration, else the checkout's
## fabriek.toml at the pin.
cmd_factory_declared() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-declared <factory>"
	[ -f "$FABRIEK_ETC/fabriek.toml" ] || die "$factory has not been brought up"
	if grep -q '^\[declaration\]$' "$FABRIEK_ETC/fabriek.toml"; then
		printf '%s\n' "$(fabriek_operator_config_path)"
	else
		printf '%s/fabriek.toml\n' "$(sed -n 's/^path = "\(.*\)"$/\1/p' "$FABRIEK_ETC/fabriek.toml")"
	fi
}

## What a factory is doing: running at its pin once prepared, stopped
## otherwise. Read off the mark and the rendered rev, which is what the
## executor's own condition reads.
cmd_factory_status() {
	local factory="${1:-}"
	[ -n "$factory" ] || die "usage: fabriek-container factory-status <factory>"
	if [ -f "$(fabriek_run_dir)/prepared" ] && [ -f "$FABRIEK_ETC/rev" ]; then
		echo "$factory: running at $(cat "$FABRIEK_ETC/rev")"
	else
		echo "$factory: stopped"
	fi
}

main() {
	local cmd="${1:-}"
	shift || true
	case "$cmd" in
	role-enter) cmd_role_enter "$@" ;;
	role-worktree) cmd_role_worktree "$@" ;;
	task-file) cmd_task_file "$@" ;;
	factory-render) cmd_factory_render "$@" ;;
	factory-endpoints) cmd_factory_endpoints "$@" ;;
	factory-profiles) cmd_factory_profiles "$@" ;;
	factory-prepare) cmd_factory_prepare "$@" ;;
	role-stop) cmd_role_stop "$@" ;;
	role-transcript) cmd_role_transcript "$@" ;;
	factory-mirror) cmd_factory_mirror "$@" ;;
	factory-up) cmd_factory_up "$@" ;;
	factory-down) cmd_factory_down "$@" ;;
	factory-status) cmd_factory_status "$@" ;;
	factory-clone) cmd_factory_clone "$@" ;;
	factory-declared) cmd_factory_declared "$@" ;;
	factory-watch) cmd_factory_watch "$@" ;;
	factory-board) cmd_factory_board "$@" ;;
	probes-publish) cmd_probes_publish "$@" ;;
	bus-users) cmd_bus_users "$@" ;;
	role-steer) cmd_role_steer "$@" ;;
	factory-send) cmd_factory_send "$@" ;;
	factory-roles) cmd_factory_roles "$@" ;;
	*)
		usage >&2
		exit 1
		;;
	esac
}

# Allow sourcing without executing (for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
