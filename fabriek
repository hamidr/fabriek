#!/usr/bin/env bash
# fabriek -- run a factory of named roles over one repository.
#
# What an operator types: fabriek [-f FACTORY] VERB [ARGS] (ADR-047). It
# brings a factory up and down on this host, files goals, reads back what
# is there, enters a role by hand, and fetches the factory's work into the
# operator's own checkout. None of it knows where the cages are: every
# machine command runs the machine program as root through sudo with the
# factory named, and machine() is the only thing here that touches the
# transport (ADR-018, ADR-067).

set -euo pipefail

FABRIEK_VERSION="1.0.0"

## What the operator's side reads: their own ceilings and the register of
## factories on this machine (ADR-020). The machine program has its own copy of
## the modules it needs; these are the ones that only make sense where the
## operator's config lives, which is here and never in a cage.
FABRIEK_LIB="${FABRIEK_LIB:-@lib@}"
# shellcheck source=modules/names.sh
. "$FABRIEK_LIB/names.sh"
# shellcheck source=modules/schema.sh
. "$FABRIEK_LIB/schema.sh"
# shellcheck source=modules/sizes.sh
. "$FABRIEK_LIB/sizes.sh"
# shellcheck source=modules/resources.sh
. "$FABRIEK_LIB/resources.sh"
# shellcheck source=modules/operator-config.sh
. "$FABRIEK_LIB/operator-config.sh"
# shellcheck source=modules/repo-declaration.sh
. "$FABRIEK_LIB/repo-declaration.sh"
# shellcheck source=modules/check.sh
. "$FABRIEK_LIB/check.sh"

## The flake check, ls and show evaluate the catalogue from: fabriek's own.
## Substituted at package time so an installed fabriek reads the catalogue
## its own revision describes, and overridable so a developer and the suite
## can point at a working tree.
FABRIEK_SELF="${FABRIEK_SELF:-@self@}"

## Colour only where somebody is looking: a line that goes to a pipe is
## plain, so the output composes (ADR-047 point 3).
if [[ -t 1 ]]; then
  GREEN=$'\033[0;32m' CYAN=$'\033[0;36m' BOLD=$'\033[1m' NC=$'\033[0m'
else
  GREEN="" CYAN="" BOLD="" NC=""
fi

log_info() { echo -e "${CYAN}fabriek:${NC} $*"; }
log_ok()   { echo -e "${GREEN}fabriek:${NC} $*"; }
## Every line to stderr begins the same way, whoever is reading it.
log_err()  { echo "fabriek: $*" >&2; }

## The verbs and their one-line usages, the one table the help, -h and a
## usage error all read from.
usage_of() {
  case "$1" in
  up)      echo "usage: fabriek up [-u|--update] [FACTORY]" ;;
  down)    echo "usage: fabriek down [FACTORY]" ;;
  fetch)   echo "usage: fabriek fetch [FACTORY]" ;;
  ps)      echo "usage: fabriek ps [--json]" ;;
  check)   echo "usage: fabriek check [--json] [REPO]" ;;
  ls)      echo "usage: fabriek ls [--json] [REPO]" ;;
  show)    echo "usage: fabriek show [--json] NAME [REPO]   or   fabriek -f FACTORY show [ROLE]" ;;
  enter)   echo "usage: fabriek [-f FACTORY] enter ROLE [-- CMD...]" ;;
  stop)    echo "usage: fabriek [-f FACTORY] stop [-k] ROLE" ;;
  steer)   echo "usage: fabriek [-f FACTORY] steer ROLE [TEXT|-]" ;;
  log)     echo "usage: fabriek [-f FACTORY] log [-t] ROLE [SESSION]" ;;
  file)    echo "usage: fabriek [-f FACTORY] file [-m BODY] WORKFLOW TITLE" ;;
  board)   echo "usage: fabriek [-f FACTORY] board" ;;
  watch)   echo "usage: fabriek [-f FACTORY] watch [--from ID] [--stream NAME]..." ;;
  send)    echo "usage: fabriek [-f FACTORY] send [JSON|-]" ;;
  mirror)  echo "usage: fabriek [-f FACTORY] mirror" ;;
  *)       echo "usage: fabriek [-f FACTORY] VERB [ARGS]" ;;
  esac
}

## A usage error is one line on stderr and exit 2; -h is the same line on
## stdout and exit 0.
usage_error() {
  usage_of "$1" >&2
  exit 2
}

## Whether -h or --help is among a verb's arguments.
wants_help() {
  local arg
  for arg in "$@"; do
    case "$arg" in -h | --help) return 0 ;; esac
  done
  return 1
}

## The factory a verb is about: the one named, else -f, else the
## environment, else the only one registered here, else a refusal that
## names the choices (ADR-047 point 1).
FACTORY_OPT=""
factory_of() {
  local named="${1:-}"
  if [[ -n "$named" ]]; then
    printf '%s\n' "$named"
    return 0
  fi
  if [[ -n "$FACTORY_OPT" ]]; then
    printf '%s\n' "$FACTORY_OPT"
    return 0
  fi
  if [[ -n "${FABRIEK_FACTORY:-}" ]]; then
    printf '%s\n' "$FABRIEK_FACTORY"
    return 0
  fi
  local registered
  registered="$(fabriek_operator_factories "$(fabriek_operator_config_path)" 2>/dev/null || true)"
  local count
  count="$(printf '%s\n' "$registered" | grep -c . || true)"
  if [[ "$count" -eq 1 ]]; then
    printf '%s\n' "$registered"
    return 0
  fi
  if [[ "$count" -eq 0 ]]; then
    log_err "which factory? name it with -f FACTORY or FABRIEK_FACTORY; none is registered in $(fabriek_operator_config_path)"
  else
    log_err "which factory? -f $(printf '%s\n' "$registered" | paste -sd' ' - | sed 's/ / or -f /g')"
  fi
  return 1
}

## Text from an argument, or from stdin when the argument is - or absent
## and stdin is not a terminal (ADR-047 point 3).
text_or_stdin() {
  local arg="${1:-}"
  if [[ -n "$arg" && "$arg" != "-" ]]; then
    printf '%s' "$arg"
  elif [[ ! -t 0 ]]; then
    cat
  fi
}

## Run a machine verb for one factory and return its output.
##
## The machine program runs on this host as root: sudo, for that one
## program, which the host's module allows the fabriek group without a
## password (ADR-067 point 1). argv passes through as argv, so nothing a
## caller passed is quoted for a shell or re-split, and the factory goes in
## the environment, which is how one program serves every factory here.
## Every verb takes the factory as its first word too, which is the machine
## program's dispatch convention rather than a coincidence of these call
## sites.
machine() {
  local factory="${2:-}"
  [[ -n "$factory" ]] || { log_err "no factory named for machine command ${1:-}"; return 1; }
  local -a sudo_args=()
  machine_sudo_args "$factory" sudo_args
  sudo "${sudo_args[@]}" fabriek-container "$@"
}

## The sudo arguments that carry one factory into the array named: the
## factory, and what the suite and a developer override (the modules'
## directory, the facts directory, the operator's file), as VAR=value
## words, which the host's rule allows with SETENV. A hand's agent socket
## goes the same way.
machine_sudo_args() {
  local factory="$1"
  # shellcheck disable=SC2034  # the caller's array, by nameref
  local -n into="$2"
  into=("FABRIEK_FACTORY=$factory")
  local var
  for var in FABRIEK_LIB FABRIEK_FACTORIES FABRIEK_CONFIG SSH_AUTH_SOCK; do
    [[ -n "${!var:-}" ]] && into+=("$var=${!var}")
  done
  return 0
}

## The system the catalogue is evaluated for: this host's, since the roles
## run here.
host_system() {
  nix eval --impure --raw --expr 'builtins.currentSystem'
}

## The factory's checkout on this host, as the operator's config names it
## and as the machine program clones it (ADR-067 point 5).
factory_path() {
  local factory="$1" path
  path="$(fabriek_operator_factory_path "$(fabriek_operator_config_path)" "$factory")" || return 1
  path="$(cd "$path" 2>/dev/null && pwd)" || {
    log_err "$factory's repository is not at the path the config names: $path"
    return 1
  }
  printf '%s\n' "$path"
}

## The operator's side of the checkout (ADR-067 point 5): a remote at the
## factory's clone, whose branches fetch into refs the factory's name owns,
## so the factory's work is seen with git branch and git log in the
## operator's own repository. Nothing in the factory writes the checkout;
## this fetch, as the operator, is the one thing that does.
checkout_remote() {
  local factory="$1" path clone
  path="$(factory_path "$factory")" || return 1
  clone="$(machine factory-clone "$factory")" || return 1
  git -C "$path" remote remove "fabriek-$factory" >/dev/null 2>&1 || true
  git -C "$path" remote add "fabriek-$factory" "$clone" || return 1
  git -C "$path" config --replace-all "remote.fabriek-$factory.fetch" "+refs/heads/*:refs/heads/fabriek/$factory/*" || return 1
  git -C "$path" config --add "remote.fabriek-$factory.fetch" "+refs/fabriek/*:refs/fabriek/$factory/*" || return 1
}

checkout_fetch() {
  local factory="$1" path
  path="$(factory_path "$factory" 2>/dev/null)" || return 0
  git -C "$path" remote get-url "fabriek-$factory" >/dev/null 2>&1 || return 0
  git -C "$path" fetch --quiet "fabriek-$factory" || {
    log_err "could not fetch $factory's branches into $path"
    return 1
  }
}

## up [-u|--update] [FACTORY]
cmd_up() {
  local update="" factory=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    -u | --update) update=1 ;;
    -*) usage_error up ;;
    *) factory="$arg" ;;
    esac
  done
  factory="$(factory_of "$factory")" || exit 2
  factory_path "$factory" >/dev/null || exit 1
  ## Everything a factory is on this host is the machine program's to make
  ## (ADR-067): the units, the clone, the render, the credentials, the
  ## forge and the bus. What the clamp changed is what it prints.
  machine factory-up "$factory" ${update:+--update} || {
    log_err "could not bring $factory up"
    exit 1
  }
  checkout_remote "$factory" || exit 1
  checkout_fetch "$factory" || exit 1
  log_ok "$factory is running"
}

## down [FACTORY]: the machine program stops the factory, refusing while a
## role's cage runs; the remote leaves the checkout and what was fetched
## stays, since those refs are the operator's now.
cmd_down() {
  [[ $# -le 1 ]] || usage_error down
  local factory
  factory="$(factory_of "${1:-}")" || exit 2
  machine factory-down "$factory" || exit 1
  local path
  if path="$(factory_path "$factory" 2>/dev/null)"; then
    git -C "$path" remote remove "fabriek-$factory" 2>/dev/null || true
  fi
}

## fetch [FACTORY]: the factory's branches into the checkout, now.
cmd_fetch() {
  [[ $# -le 1 ]] || usage_error fetch
  local factory
  factory="$(factory_of "${1:-}")" || exit 2
  checkout_fetch "$factory" || exit 1
}

## ps [--json]: every factory the operator declared, and what the machine
## program says of it. Each running factory's branches are fetched on the
## way, so the checkout is as current as the answer.
cmd_ps() {
  local json=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    --json) json=1 ;;
    *) usage_error ps ;;
    esac
  done
  local factory answer state rev rows=()
  while IFS= read -r factory; do
    [ -n "$factory" ] || continue
    answer="$(machine factory-status "$factory" 2>/dev/null)" || answer="$factory: stopped"
    answer="${answer#"$factory": }"
    case "$answer" in
    running\ at\ *) state=running; rev="${answer#running at }"; checkout_fetch "$factory" || true ;;
    *) state=stopped; rev="" ;;
    esac
    if [[ -n "$json" ]]; then
      rows+=("$(jq -cn --arg f "$factory" --arg s "$state" --arg r "$rev" \
        '{factory: $f, state: $s, rev: (if $r == "" then null else $r end)}')")
    else
      printf '%s\t%s\n' "$factory" "$answer"
    fi
  done < <(fabriek_operator_factories "$(fabriek_operator_config_path)" 2>/dev/null)
  if [[ -n "$json" ]]; then
    printf '%s\n' "${rows[@]+"${rows[@]}"}" | jq -cs .
  fi
}

## check [--json] [REPO]: what up would refuse, said in seconds on this
## host (ADR-042).
cmd_check() {
  local json="" repo=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    --json) json=1 ;;
    -*) usage_error check ;;
    *) repo="$arg" ;;
    esac
  done
  local system
  system="$(host_system)" || exit 1
  FABRIEK_JSON="$json" fabriek_check_repo "$FABRIEK_SELF" "${repo:-.}" "$system"
}

## ls [--json] [REPO]: every specialist and skill, fabriek's and the
## repository's (ADR-042).
cmd_ls() {
  local json="" repo=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    --json) json=1 ;;
    -*) usage_error ls ;;
    *) repo="$arg" ;;
    esac
  done
  local system
  system="$(host_system)" || exit 1
  FABRIEK_JSON="$json" fabriek_catalogue_list "$FABRIEK_SELF" "$system" "$repo"
}

## show [--json] NAME [REPO], or with -f, show ROLE: what one specialist
## brings, or what a registered factory's role is composed of, at its
## commit, no build (ADR-042).
cmd_show() {
  local json="" name="" repo=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    --json) json=1 ;;
    -*) usage_error show ;;
    *) if [[ -z "$name" ]]; then name="$arg"; else repo="$arg"; fi ;;
    esac
  done
  ## show -f FACTORY, nothing named: what a running factory is made of
  ## (ADR-057 point 7), the run's identity: the appliance, the pin, and the
  ## profile the machine built for each role.
  if [[ -z "$name" && (-n "$FACTORY_OPT" || -n "${FABRIEK_FACTORY:-}") ]]; then
    local factory profiles
    factory="$(factory_of "")" || exit 2
    profiles="$(machine factory-profiles "$factory")" || exit 1
    ## Which file declared it (ADR-061 point 6): the repository's at the
    ## pin, or the operator's own, which the machine program says.
    local declared
    declared="$(machine factory-declared "$factory" 2>/dev/null)" || declared=""
    if [[ -n "$json" ]]; then
      printf '%s' "$profiles" | jq -c --arg declared "$declared" '. + {declaration: $declared}'
    else
      printf '%s' "$profiles" | jq -r '"rev: \(.rev)", (.roles | to_entries[] | "  \(.key): \(.value)"), "  decider: \(.decider)"'
      [[ -z "$declared" ]] || echo "declared in: $declared"
    fi
    return
  fi
  [[ -n "$name" ]] || usage_error show
  local system
  system="$(host_system)" || exit 1
  if [[ -n "$FACTORY_OPT" || -n "${FABRIEK_FACTORY:-}" ]]; then
    local factory path
    factory="$(factory_of "")" || exit 2
    path="$(fabriek_operator_factory_path "$(fabriek_operator_config_path)" "$factory")" || exit 1
    FABRIEK_JSON="$json" fabriek_role_show "$FABRIEK_SELF" "$system" "$path" "$name"
  else
    FABRIEK_JSON="$json" fabriek_catalogue_show "$FABRIEK_SELF" "$system" "$name" "$repo"
  fi
}

## enter ROLE [-- CMD...]: a declared role by hand. A person: the session
## signs through their forwarded agent, exactly as entering an ordinary
## project does, and ADR-009's cage key belongs to the run nobody watches.
cmd_enter() {
  local factory role="${1:-}"
  [[ -n "$role" ]] || usage_error enter
  factory="$(factory_of "")" || exit 2
  shift
  [[ "${1:-}" == "--" ]] && shift

  ## A person signs through their own agent, exactly as entering an
  ## ordinary project does; the socket is on this host and is named to the
  ## machine program by path, which hands it to nixcage (ADR-067). The
  ## executor's sessions carry the cage key instead (ADR-009).
  local -a use_agent=()
  if [[ -n "${SSH_AUTH_SOCK:-}" && -e "${SSH_AUTH_SOCK}" ]]; then
    use_agent=(--auth-sock "$SSH_AUTH_SOCK")
  fi
  [[ $# -eq 0 ]] && log_info "Entering role $role of factory $factory..."

  ## Where this factory's repository is: the checkout on this host, which
  ## the machine program clones by path (ADR-067 point 5). Needed the first
  ## time only, since after that the clone records where it came from.
  local repository=()
  local path
  if path="$(factory_path "$factory" 2>/dev/null)"; then
    repository=(--repository "$path")
  fi

  local -a sudo_args=()
  machine_sudo_args "$factory" sudo_args
  exec sudo "${sudo_args[@]}" fabriek-container role-enter \
    ${use_agent[@]+"${use_agent[@]}"} ${repository[@]+"${repository[@]}"} "$factory" "$role" "$@"
}

## stop [-k] ROLE: end a role's running turn through the executor; -k ends
## the cage itself at its scope (ADR-045), for a turn that no longer
## answers. Quiet on success.
cmd_stop() {
  local kill="" role=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    -k | --kill) kill=1 ;;
    -*) usage_error stop ;;
    *) role="$arg" ;;
    esac
  done
  [[ -n "$role" ]] || usage_error stop
  local factory
  factory="$(factory_of "")" || exit 2
  machine role-stop "$factory" "$role" ${kill:+--now} >/dev/null
}

## steer ROLE [TEXT|-]: speak into a role's running turn; the words go to
## the executor, which queues them at the next tool boundary.
cmd_steer() {
  local role="${1:-}"
  [[ -n "$role" ]] || usage_error steer
  local factory text
  factory="$(factory_of "")" || exit 2
  text="$(text_or_stdin "${2:-}")"
  [[ -n "$text" ]] || usage_error steer
  machine role-steer "$factory" "$role" "$text" >/dev/null
}

## log [-t] ROLE [SESSION]: the sessions pi kept in the role's home on the
## machine, or one of them, as it is or as the turns' text.
cmd_log() {
  local text="" role="" session=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    -t | --text) text=1 ;;
    -*) usage_error log ;;
    *) if [[ -z "$role" ]]; then role="$arg"; else session="$arg"; fi ;;
    esac
  done
  [[ -n "$role" ]] || usage_error log
  local factory
  factory="$(factory_of "")" || exit 2
  ## Flags trail on the wire: the machine program reads the factory as its
  ## second word.
  machine role-transcript "$factory" "$role" ${session:+"$session"} ${text:+--text}
}

## file [-m BODY] WORKFLOW TITLE: a goal, filed into a factory. The
## workflow's first stage says who takes it and the decider says when; the
## title and body reach the machine as words and become files there, so the
## executor reads files and never argv (the second invariant). The body
## comes from -m or from stdin.
cmd_file() {
  local body="" workflow="" title=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -m | --message)
      body="${2:-}"
      shift 2 || usage_error file
      ;;
    -*) usage_error file ;;
    *)
      if [[ -z "$workflow" ]]; then workflow="$1"; elif [[ -z "$title" ]]; then title="$1"; else usage_error file; fi
      shift
      ;;
    esac
  done
  [[ -n "$workflow" && -n "$title" ]] || usage_error file
  [[ -n "$body" ]] || body="$(text_or_stdin "")"
  local factory
  factory="$(factory_of "")" || exit 2
  machine task-file "$factory" "$workflow" "$title" "$body"
}

## board: Forgejo's UI, on the factory's bridge, which this host reaches
## directly (ADR-067). Merging is a click there and has no verb (ADR-036).
## The machine program says the address and sets the operator's password
## fresh, so nothing here guesses one.
cmd_board() {
  [[ $# -eq 0 ]] || usage_error board
  local factory
  factory="$(factory_of "")" || exit 2
  local answer addr password
  answer="$(machine factory-board "$factory")" || exit 1
  addr="$(sed -n 1p <<<"$answer")"
  password="$(sed -n 2p <<<"$answer")"
  [[ -n "$addr" && -n "$password" ]] || { log_err "$factory did not say where its board is"; exit 1; }
  checkout_fetch "$factory" || true
  echo "http://$addr/operator/$factory"
  echo "log in as operator with the password $password"
}

cmd_watch() {
  local factory
  factory="$(factory_of "")" || exit 2
  checkout_fetch "$factory" || true
  ## The bus as JSONL on stdout; what any client reads (ADR-039 point 2).
  machine factory-watch "$factory" "$@"
}

cmd_send() {
  [[ $# -le 1 ]] || usage_error send
  local factory json
  factory="$(factory_of "")" || exit 2
  json="$(text_or_stdin "${1:-}")"
  [[ -n "$json" ]] || usage_error send
  ## A command in the decider's vocabulary, from the operator, validated by
  ## the executor as the decider's would be.
  machine factory-send "$factory" "$json" >/dev/null
}

cmd_mirror() {
  [[ $# -eq 0 ]] || usage_error mirror
  local factory
  factory="$(factory_of "")" || exit 2
  ## Merged main and the record reach the clone on the operator's word and
  ## never before (ADR-036 point 7); then the checkout, by fetch.
  machine factory-mirror "$factory"
  checkout_fetch "$factory" || true
}

cmd_help() {
  cat <<HELP
${BOLD}fabriek${NC} v${FABRIEK_VERSION}: a factory of named roles over one repository

${BOLD}Usage:${NC}
  fabriek [-f FACTORY] VERB [ARGS]

  The factory a verb is about: -f, else FABRIEK_FACTORY, else the one
  factory registered here. Every verb takes -h.

${BOLD}Commands:${NC}
  up [-u] [FACTORY]  Bring a factory up on this host, pinned to the
                     checkout's commit; -u moves the pin to HEAD. Its
                     branches appear in the checkout as fabriek/NAME/*
  down [FACTORY]     Stop it, refusing while a role's cage runs
  fetch [FACTORY]    The factory's branches into the checkout, now
  ps [--json]        Every factory declared here, and what each is doing
  check [REPO]       What up would refuse: the declaration at its commit and
                     every specialist each role names, in seconds, no build
  ls [REPO]          Every specialist and skill, fabriek's and the repository's
  show NAME [REPO]   What a specialist brings; with -f, what a role of the
                     factory is composed of, at its commit; with -f and no
                     NAME, what the running factory is made of: the pin and
                     the profile built for each role
  enter ROLE [-- CMD...]
                     Enter a declared role in its own worktree and uid, by hand
  stop [-k] ROLE     End a role's running turn through the executor; -k ends
                     the cage at its scope
  steer ROLE [TEXT]  Speak into a role's running turn; TEXT or stdin
  log [-t] ROLE [SESSION]
                     The sessions pi kept for a role, or one of them, as it
                     is or, with -t, as the turns' text
  file [-m BODY] WORKFLOW TITLE
                     File a goal; the body from -m or stdin; the decider
                     assigns it and nothing is typed after
  board              Where Forgejo's UI is, and the login, for merging
  watch [--from ID]  The factory's bus as JSON lines, for any client
  send [JSON]        A command in the decider's vocabulary, from you
  mirror             Merged main and the record into the clone, then the checkout
  version            Print the version
  help               This

${BOLD}Configuration:${NC}
  $(fabriek_operator_config_path)
  [caps] what a factory may cost here; [factories.NAME] path = its checkout
  (a factory is declared on the host with services.fabriek, ADR-067);
  [credentials.HOST] header and file; [models] HOST = the model to start on.
HELP
}

main() {
  ## -f FACTORY is taken wherever it stands before a "--", so it reads the
  ## same before and after the verb; everything else is the verb's.
  local -a rest=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -f | --factory)
      FACTORY_OPT="${2:-}"
      [[ -n "$FACTORY_OPT" ]] || usage_error ""
      shift 2
      ;;
    -f?*) FACTORY_OPT="${1#-f}"; shift ;;
    --)
      rest+=("$@")
      break
      ;;
    *)
      rest+=("$1")
      shift
      ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  ## Then the global flags that stand alone, before any verb.
  case "${1:-}" in
  -h | --help) cmd_help; exit 0 ;;
  -v | --version) echo "fabriek $FABRIEK_VERSION"; exit 0 ;;
  -*) usage_error "" ;;
  esac
  local command="${1:-help}"
  shift || true
  if wants_help "$@"; then
    case "$command" in
    help | version) cmd_help ;;
    *) usage_of "$command" ;;
    esac
    exit 0
  fi
  case "$command" in
  up)      cmd_up "$@" ;;
  down)    cmd_down "$@" ;;
  fetch)   cmd_fetch "$@" ;;
  ps)      cmd_ps "$@" ;;
  check)   cmd_check "$@" ;;
  ls)      cmd_ls "$@" ;;
  show)    cmd_show "$@" ;;
  enter)   cmd_enter "$@" ;;
  stop)    cmd_stop "$@" ;;
  steer)   cmd_steer "$@" ;;
  log)     cmd_log "$@" ;;
  file)    cmd_file "$@" ;;
  board)   cmd_board "$@" ;;
  watch)   cmd_watch "$@" ;;
  send)    cmd_send "$@" ;;
  mirror)  cmd_mirror "$@" ;;
  version) echo "fabriek $FABRIEK_VERSION" ;;
  help)    cmd_help ;;
  *)
    log_err "unknown verb: $command"
    cmd_help >&2
    exit 2
    ;;
  esac
}

# Allow sourcing without executing (for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
