#!/usr/bin/env bash
# fabriek -- run a factory of named roles over one repository.
#
# What an operator types: fabriek [-f FACTORY] VERB [ARGS] (ADR-047). It
# starts and stops a factory's machine, files goals, reads back what is
# there, enters a role by hand, and hands the factory's work to the
# operator's own repository. None of it knows where the cages are: every
# machine command goes over ssh to the machine fabriek built for that
# factory, and machine() is the only thing here that touches the transport
# (ADR-018, ADR-019).

set -euo pipefail

FABRIEK_VERSION="1.0.0"

## What the operator's side reads: their own ceilings and the register of
## factories on this machine (ADR-020). The machine program has its own copy of
## the modules it needs; these are the ones that only make sense where the
## operator's config lives, which is here and never in a cage.
FABRIEK_LIB="${FABRIEK_LIB:-@lib@}"
# shellcheck source=modules/names.sh
. "$FABRIEK_LIB/names.sh"
# shellcheck source=modules/schema.sh
. "$FABRIEK_LIB/schema.sh"
# shellcheck source=modules/sizes.sh
. "$FABRIEK_LIB/sizes.sh"
# shellcheck source=modules/resources.sh
. "$FABRIEK_LIB/resources.sh"
# shellcheck source=modules/operator-config.sh
. "$FABRIEK_LIB/operator-config.sh"
# shellcheck source=modules/repo-declaration.sh
. "$FABRIEK_LIB/repo-declaration.sh"
# shellcheck source=modules/machine-spec.sh
. "$FABRIEK_LIB/machine-spec.sh"
# shellcheck source=modules/credential.sh
. "$FABRIEK_LIB/credential.sh"
# shellcheck source=modules/machine.sh
. "$FABRIEK_LIB/machine.sh"
# shellcheck source=modules/check.sh
. "$FABRIEK_LIB/check.sh"

## The flake a machine is built from: fabriek' own. Substituted at package
## time so an installed fabriek builds the machine its own revision
## describes, and overridable so a developer and the suite can point at a
## working tree.
FABRIEK_SELF="${FABRIEK_SELF:-@self@}"

## Colour only where somebody is looking: a line that goes to a pipe is
## plain, so the output composes (ADR-047 point 3).
if [[ -t 1 ]]; then
  GREEN=$'\033[0;32m' CYAN=$'\033[0;36m' BOLD=$'\033[1m' NC=$'\033[0m'
else
  GREEN="" CYAN="" BOLD="" NC=""
fi

log_info() { echo -e "${CYAN}fabriek:${NC} $*"; }
log_ok()   { echo -e "${GREEN}fabriek:${NC} $*"; }
## Every line to stderr begins the same way, whoever is reading it.
log_err()  { echo "fabriek: $*" >&2; }

## What builds a machine, locks its flake and reads the spec back out of it.
## Named once for the same reason as the above: everything nix does for a
## machine goes through it, so it is the one thing a test has to stand in for.
NIX="${FABRIEK_NIX:-nix}"

## The verbs and their one-line usages, the one table the help, -h and a
## usage error all read from.
usage_of() {
  case "$1" in
  up)      echo "usage: fabriek up [-u|--update] [FACTORY]" ;;
  down)    echo "usage: fabriek down [FACTORY]" ;;
  ps)      echo "usage: fabriek ps [--json]" ;;
  check)   echo "usage: fabriek check [--json] [REPO]" ;;
  ls)      echo "usage: fabriek ls [--json] [REPO]" ;;
  show)    echo "usage: fabriek show [--json] NAME [REPO]   or   fabriek -f FACTORY show [ROLE]" ;;
  enter)   echo "usage: fabriek [-f FACTORY] enter ROLE [-- CMD...]" ;;
  stop)    echo "usage: fabriek [-f FACTORY] stop [-k] ROLE" ;;
  steer)   echo "usage: fabriek [-f FACTORY] steer ROLE [TEXT|-]" ;;
  log)     echo "usage: fabriek [-f FACTORY] log [-t] ROLE [SESSION]" ;;
  file)    echo "usage: fabriek [-f FACTORY] file [-m BODY] WORKFLOW TITLE" ;;
  console) echo "usage: fabriek [-f FACTORY] console" ;;
  board)   echo "usage: fabriek [-f FACTORY] board" ;;
  watch)   echo "usage: fabriek [-f FACTORY] watch [--from ID] [--stream NAME]..." ;;
  send)    echo "usage: fabriek [-f FACTORY] send [JSON|-]" ;;
  mirror)  echo "usage: fabriek [-f FACTORY] mirror" ;;
  *)       echo "usage: fabriek [-f FACTORY] VERB [ARGS]" ;;
  esac
}

## A usage error is one line on stderr and exit 2; -h is the same line on
## stdout and exit 0.
usage_error() {
  usage_of "$1" >&2
  exit 2
}

## Whether -h or --help is among a verb's arguments.
wants_help() {
  local arg
  for arg in "$@"; do
    case "$arg" in -h | --help) return 0 ;; esac
  done
  return 1
}

## The factory a verb is about: the one named, else -f, else the
## environment, else the only one registered here, else a refusal that
## names the choices (ADR-047 point 1).
FACTORY_OPT=""
factory_of() {
  local named="${1:-}"
  if [[ -n "$named" ]]; then
    printf '%s\n' "$named"
    return 0
  fi
  if [[ -n "$FACTORY_OPT" ]]; then
    printf '%s\n' "$FACTORY_OPT"
    return 0
  fi
  if [[ -n "${FABRIEK_FACTORY:-}" ]]; then
    printf '%s\n' "$FABRIEK_FACTORY"
    return 0
  fi
  local registered
  registered="$(fabriek_operator_factories "$(fabriek_operator_config_path)" 2>/dev/null || true)"
  local count
  count="$(printf '%s\n' "$registered" | grep -c . || true)"
  if [[ "$count" -eq 1 ]]; then
    printf '%s\n' "$registered"
    return 0
  fi
  if [[ "$count" -eq 0 ]]; then
    log_err "which factory? name it with -f FACTORY or FABRIEK_FACTORY; none is registered in $(fabriek_operator_config_path)"
  else
    log_err "which factory? -f $(printf '%s\n' "$registered" | paste -sd' ' - | sed 's/ / or -f /g')"
  fi
  return 1
}

## Text from an argument, or from stdin when the argument is - or absent
## and stdin is not a terminal (ADR-047 point 3).
text_or_stdin() {
  local arg="${1:-}"
  if [[ -n "$arg" && "$arg" != "-" ]]; then
    printf '%s' "$arg"
  elif [[ ! -t 0 ]]; then
    cat
  fi
}

## Run a machine command on the factory's own machine and return its output.
##
## The words are sent NUL-separated and split by xargs -0 on the far side, so
## the remote command is three fixed words and nothing a caller passed is ever
## quoted for a remote shell or re-split. ssh would otherwise join argv into one
## string, and a task's acceptance or a role's outcome would be part of it.
##
## Which machine is read off the verb's own first argument: every machine verb
## takes the factory there, which is the machine program's dispatch convention
## rather than a coincidence of these call sites.
## The ssh arguments that reach one factory's machine, into the array named.
## Captured before the loop, because a failure inside a process substitution
## does not reach the while that reads it: the args would come back empty and
## ssh would go to localhost on port 22 with no key.
machine_ssh_args() {
  local factory="$1"
  local -n into="$2"
  local args arg
  args="$(fabriek_machine_ssh_args "$factory")" || return 1
  into=()
  while IFS= read -r arg; do into+=("$arg"); done <<<"$args"
}

## A local port nothing listens on, from 8300 up, for a tunnel to the board.
free_local_port() {
  local port
  for port in $(seq 8300 8399); do
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || { echo "$port"; return 0; }
  done
  log_err "no free local port between 8300 and 8399"
  return 1
}

machine() {
  local factory="${2:-}"
  [[ -n "$factory" ]] || { log_err "no factory named for machine command ${1:-}"; return 1; }

  local -a ssh_args=()
  machine_ssh_args "$factory" ssh_args || return 1

  printf '%s\0' "$@" |
    ssh "${ssh_args[@]}" root@localhost xargs -0 fabriek-container
}

## The machine is always Linux, whatever the operator is on. A machine that
## reported the host's system would build a darwin machine and fail late.
host_system() {
  nix eval --impure --raw --expr 'builtins.currentSystem'
}

## The machine is always Linux, whatever the operator is on.
machine_system() {
  local host
  host="$(host_system)" || return 1
  case "$host" in
  aarch64-*) echo "aarch64-linux" ;;
  x86_64-*) echo "x86_64-linux" ;;
  *)
    log_err "no Linux machine for $host"
    return 1
    ;;
  esac
}

## What one factory's machine is, as the spec modules/vm.nix takes. Built from
## the declaration the repository committed, clamped by this host's ceilings,
## plus the way in that belongs to this factory alone.
## Where this factory's repository is, as a remote the machine can reach
## (ADR-032). The register names a checkout on this host, which the machine
## cannot open; the origin of that checkout is what it clones. Read here
## rather than declared a second time, because two places naming one remote
## are two places that can disagree.
factory_origin() {
  local factory="$1" path origin
  path="$(fabriek_operator_factory_path "$(fabriek_operator_config_path)" "$factory")" || return 1
  if origin="$(git -C "$path" remote get-url origin 2>/dev/null)" && [[ -n "$origin" ]]; then
    printf '%s\n' "$origin"
  else
    log_err "$factory's repository at $path has no origin, and a machine cannot clone a path on this host"
    return 1
  fi
}

## What a machine is handed and started with (ADR-057 points 2 and 3):
## the credential, the operator's config.toml projected for this factory
## plus the pin; runtime.json, the facts the runner's script puts on the
## hypervisor's command line; and the two disks, made once at the size the
## caps allow. The pin is HEAD at the first up and moves only with -u,
## because which commit a machine works is its identity.
machine_handover() {
  local factory="$1" dir="$2" update="$3" config path remote rev
  config="$(fabriek_operator_config_path)"
  path="$(fabriek_operator_factory_path "$config" "$factory")" || return 1
  path="$(cd "$path" 2>/dev/null && pwd)" || {
    log_err "$factory's repository is not at the path the config names: $path"
    return 1
  }
  remote="$(factory_origin "$factory")" || return 1

  local credential="$dir/fabriek.toml"
  if [[ -f "$credential" && -z "$update" ]]; then
    rev="$(fabriek_credential_rev "$credential")"
  else
    rev="$(git -C "$path" rev-parse HEAD 2>/dev/null)" || {
      log_err "$factory's repository at $path has no commit to pin"
      return 1
    }
  fi
  fabriek_operator_config "$config" >"$dir/config.json.new" || return 1
  fabriek_credential_toml "$dir/config.json.new" "$factory" "$remote" "$rev" "$(host_system)" >"$credential.new" || return 1
  rm -f "$dir/config.json.new"
  mv "$credential.new" "$credential"

  ## The machine's size is what the factory asked and the operator allows,
  ## clamped here from the declaration at the pin, which since ADR-058 is a
  ## file this host reads without evaluating anything of the repository's.
  local declaration local_file spec
  declaration="$(mktemp)"
  local_file="$(mktemp)"
  fabriek_declaration_read "$path" "$rev" >"$declaration" || { rm -f "$declaration" "$local_file"; return 1; }
  jq -n --arg factory "$factory" --argjson caps "$(fabriek_operator_caps "$config")" \
    '{ factory: $factory, caps: $caps }' >"$local_file"
  spec="$(fabriek_machine_spec "$declaration" "$local_file" 2>/dev/null)" || {
    fabriek_machine_spec "$declaration" "$local_file" >/dev/null
    rm -f "$declaration" "$local_file"
    return 1
  }
  rm -f "$declaration" "$local_file"
  printf '%s' "$spec" | jq -c \
    --argjson port "$(cat "$dir/port")" '
    { mem: (.mem // 8192), cpus: (.cpus // 4), sshPort: $port, diskSize: 65536,
      credentials: { "fabriek.toml": "fabriek.toml", "fabriek.authorized_keys": "id_ed25519.pub" } }' \
    >"$dir/runtime.json.new" || return 1
  mv "$dir/runtime.json.new" "$dir/runtime.json"

  ## The machine's host key lives on its pool, so a pool made anew is a
  ## new host at the same port, and what the old one answered with would
  ## refuse it as changed.
  local image
  for image in store.img pool.img; do
    [[ -e "$dir/$image" ]] && continue
    truncate -s "$(jq -r .diskSize "$dir/runtime.json")M" "$dir/$image" || return 1
    [[ "$image" == pool.img ]] && rm -f "$dir/known_hosts"
  done
  return 0
}

## The appliance, the one machine every factory runs in, built or fetched
## once and rooted beside the machine's directory (ADR-057 points 1, 5a).
## nix ends a failed build's trace with the thrown message, which is the one
## line the operator can act on; it is printed first, the trace after.
machine_appliance() {
  local dir="$1" build_err runner
  build_err="$(mktemp)"
  runner="$("$NIX" build --out-link "$dir/appliance" --print-out-paths "path:$FABRIEK_SELF#machine" 2>"$build_err")" || {
    local thrown
    thrown="$(grep -E '^[[:space:]]*error: .' "$build_err" | tail -1 | sed 's/^[[:space:]]*error: //')"
    [[ -n "$thrown" ]] && log_err "$thrown"
    cat "$build_err" >&2
    rm -f "$build_err"
    return 1
  }
  cat "$build_err" >&2
  rm -f "$build_err"
  printf '%s\n' "$runner"
}

## virtiofsd for the host's store, on a Linux host, before the runner: the
## runner's wrapper expects it up and lists its commands in a supervisord
## configuration it would run as root; each is started here as the operator,
## as nixcage's own CLI does. A macOS host shares over 9p and has none.
machine_start_shares() {
  local dir="$1" runner="$2" conf line
  local wrapper="$runner/bin/virtiofsd-run"
  [[ -x "$wrapper" ]] || return 0
  conf="$(grep -oE -- '--configuration[[:space:]]+\S+' "$wrapper" | awk '{print $2}')"
  [[ -n "$conf" && -r "$conf" ]] || {
    log_err "the runner's virtiofsd wrapper names a configuration that is not readable: $conf"
    return 1
  }
  : >"$dir/virtiofsd.pids"
  ## Each [program:] is one daemon; supervisord's own [eventlistener:] is
  ## not. The program is microvm.nix's wrapper script, run as text so that
  ## its --socket-group (a group the operator need not be in) can go.
  local section="" program args pid
  while IFS= read -r line; do
    case "$line" in
    \[program:*) section=program ;;
    \[*) section="" ;;
    command=*)
      [[ "$section" == program ]] || continue
      program="${line#command=}"
      args="${program#"${program%% *}"}"
      program="${program%% *}"
      args="${args//--socket-group=[^ ]*/}"
      # shellcheck disable=SC2086  # the wrapper's arguments are words
      pid="$(cd "$dir" && fabriek_machine_spawn "$dir/virtiofsd.log" bash -c "$(sed 's/--socket-group=[^[:space:]]*//g' "$program")" "$program" $args)"
      echo "$pid" >>"$dir/virtiofsd.pids"
      ;;
    esac
  done <"$conf"
}

## The paths the machine uses of this host's store, rooted here so a garbage
## collection on the host removes nothing under a running cage (ADR-057
## point 5a). Paths only the machine holds are skipped: they are its own.
machine_root_profiles() {
  local factory="$1" dir="$2" profiles path role
  profiles="$(machine factory-profiles "$factory" 2>/dev/null)" || return 0
  mkdir -p "$dir/roots"
  while IFS=$'\t' read -r role path; do
    [[ -n "$path" ]] || continue
    "$NIX" path-info "$path" >/dev/null 2>&1 || continue
    nix-store --add-root "$dir/roots/$role" --indirect -r "$path" >/dev/null 2>&1 || true
  done < <(printf '%s' "$profiles" | jq -r '.roles | to_entries[] | "\(.key)\t\(.value)"')
}

## up [-u|--update] [FACTORY]
cmd_up() {
  local update="" factory=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    -u | --update) update=1 ;;
    -*) usage_error up ;;
    *) factory="$arg" ;;
    esac
  done
  factory="$(factory_of "$factory")" || exit 2
  if fabriek_machine_running "$factory"; then
    log_ok "$factory is already running"
    return
  fi
  local dir runner
  dir="$(fabriek_machine_ensure "$factory")" || exit 1
  machine_handover "$factory" "$dir" "$update" || exit 1

  log_info "Fetching the machine $factory runs in..."
  runner="$(machine_appliance "$dir")" || {
    log_err "could not build the machine $factory runs in"
    exit 1
  }

  ## The runner is started in the machine's own directory: runtime.json,
  ## the credentials and the disks are there, and no factory writes into
  ## another's. Detached into a session of its own. A machine that ends
  ## when the command that started it ends is not one anything can be run
  ## in later, and every verb after this asks whether it is still up.
  log_info "Starting $factory on port $(fabriek_machine_port "$factory")..."
  machine_start_shares "$dir" "$runner" || exit 1
  local runner_pid
  runner_pid="$(cd "$dir" && fabriek_machine_spawn "$dir/console.log" "$runner/bin/microvm-run")"
  disown "$runner_pid" 2>/dev/null || true
  echo "$runner_pid" >"$dir/pid.new"
  mv "$dir/pid.new" "$dir/pid"

  ## What the build did, now on the machine at boot (ADR-057 point 4): the
  ## repository at the pin, the declaration clamped, the files, the
  ## profiles. What the clamp changed is what it prints.
  machine_wait "$factory" || exit 1
  machine factory-render "$factory" || {
    log_err "could not render the factory on $factory's machine"
    exit 1
  }
  give_credentials "$factory" || exit 1
  ## What the machine needs to have before a factory can run on it, made
  ## once and confirmed on every up (ADR-036). On the machine, because that
  ## is where the forge and the bus are.
  machine factory-prepare "$factory" "$(factory_origin "$factory")" || {
    log_err "could not prepare the factory on $factory's machine"
    exit 1
  }
  machine_root_profiles "$factory" "$dir"
  log_ok "$factory is running"
}

## The machine was started a moment ago and is not answering yet.
machine_wait() {
  local factory="$1" waited=0
  local -a ssh_args=()
  machine_ssh_args "$factory" ssh_args || return 1
  until ssh "${ssh_args[@]}" root@localhost true </dev/null >/dev/null 2>&1; do
    if [[ "$waited" -ge 180 ]]; then
      log_err "$factory did not answer in time"
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

## Put this factory's credentials where only its proxy can read them
## (ADR-025 point 1). They go over the machine's own transport after it is up,
## because the pool they land on does not exist until it has booted.
##
## Each secret is piped into a remote install(1) rather than passed to it. An
## argument is readable from /proc by anything on the machine, and the whole
## point of the credential being here is that it is readable by one uid.
give_credentials() {
  local factory="$1" config creds hosts host file
  ## Which endpoints the rendered factory reaches: the machine's answer,
  ## after the clamp, so a credential for an endpoint the operator did not
  ## allow this factory never leaves the host.
  hosts="$(machine factory-endpoints "$factory")" || return 1
  [[ -n "$hosts" ]] || return 0

  config="$(fabriek_operator_config_path)"
  creds="$(fabriek_operator_credentials "$config")" || return 1

  local -a ssh_args=()
  machine_ssh_args "$factory" ssh_args || return 1

  while IFS= read -r host; do
    [[ -n "$host" ]] || continue
    file="$(printf '%s' "$creds" | jq -r --arg h "$host" '.[$h].file // empty')"
    if [[ ! -f "$file" ]]; then
      log_err "the credential for $host is not at $file"
      return 1
    fi
    ## The machine is asked to file the credential rather than told where to
    ## put it. Reaching into nixcage's state layout from here is the coupling
    ## ADR-018 exists to remove, and the machine already knows its own.
    ##
    ## $host expands here on purpose. The operator's config is refused when a
    ## credential is keyed by something that is not a host, so what reaches the
    ## far side is a name and never an expression.
    # shellcheck disable=SC2029
    if ! ssh "${ssh_args[@]}" root@localhost \
      "fabriek-egress-credential $host" \
      <"$file"; then
      log_err "could not give $factory the credential for $host"
      return 1
    fi
  done <<<"$hosts"

  ## The proxy read its headers when it started, which was before any of this.
  ## Nothing goes over stdin here, so nothing of the caller's is offered.
  if ! ssh "${ssh_args[@]}" root@localhost \
    "systemctl restart fabriek-egress-credentials nginx" </dev/null >/dev/null 2>&1; then
    log_err "$factory has its credentials but its proxy would not pick them up"
    return 1
  fi
}

## Stop a factory's machine by shutting it down. A stop that cannot
## complete is reported and the machine keeps running: ADR-017 exists because
## one was ended rather than shut down, and fabriek owns the stopping now.
## down [FACTORY]
cmd_down() {
  [[ $# -le 1 ]] || usage_error down
  local factory
  factory="$(factory_of "${1:-}")" || exit 2

  if ! fabriek_machine_running "$factory"; then
    log_ok "$factory is not running"
    return
  fi

  local -a ssh_args=()
  machine_ssh_args "$factory" ssh_args || return 1

  log_info "Shutting $factory down..."
  ## Asked in two steps because one would conflate two different answers. A
  ## machine that cannot be reached has refused; a machine that powers off
  ## takes the connection down with it, so ssh reports a dropped connection
  ## for the successful case and its verdict on the poweroff itself is worth
  ## nothing. Whether it stopped is whether the process ended.
  if ! ssh "${ssh_args[@]}" root@localhost true 2>/dev/null; then
    log_err "$factory would not accept a shutdown; it is still running"
    exit 1
  fi
  ssh "${ssh_args[@]}" root@localhost systemctl poweroff >/dev/null 2>&1 || true

  local pid waited=0
  pid="$(fabriek_machine_pid "$factory")"
  while kill -0 "$pid" 2>/dev/null; do
    if [[ "$waited" -ge 60 ]]; then
      log_err "$factory has not stopped after 60s; it is still running and has not been killed"
      exit 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  local dir
  dir="$(fabriek_machine_dir "$factory")"
  rm -f "$dir/pid"
  ## The share daemons the machine's store came through, on a Linux host;
  ## started by up, ended here, and nothing without a machine to serve.
  if [[ -f "$dir/virtiofsd.pids" ]]; then
    local vpid
    while IFS= read -r vpid; do
      [[ -n "$vpid" ]] && kill "$vpid" 2>/dev/null || true
    done <"$dir/virtiofsd.pids"
    rm -f "$dir/virtiofsd.pids"
  fi
  log_ok "$factory has stopped"
}

## ps [--json]: the machines on this host, what each is doing, and the port
## it answers on.
cmd_ps() {
  local json=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    --json) json=1 ;;
    *) usage_error ps ;;
    esac
  done
  local factory port dir state disk rows=()
  while IFS= read -r factory; do
    [ -n "$factory" ] || continue
    port="$(fabriek_machine_port "$factory" 2>/dev/null)" || port="-"
    dir="$(fabriek_machine_dir "$factory")" || continue
    state="stopped"
    fabriek_machine_running "$factory" && state="running"
    disk="no disk yet"
    [ -f "$dir/pool.img" ] && disk="disk"
    if [[ -n "$json" ]]; then
      rows+=("$(jq -cn --arg f "$factory" --arg p "$port" --arg s "$state" --arg d "$disk" \
        '{factory: $f, port: ($p | tonumber? // null), state: $s, disk: ($d == "disk")}')")
    else
      printf '%s\tport %s\t%s\t%s\n' "$factory" "$port" "$state" "$disk"
    fi
  done < <(fabriek_machine_list)
  if [[ -n "$json" ]]; then
    printf '%s\n' "${rows[@]+"${rows[@]}"}" | jq -cs .
  fi
}

## check [--json] [REPO]: what up would refuse, said in seconds on this
## host (ADR-042).
cmd_check() {
  local json="" repo=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    --json) json=1 ;;
    -*) usage_error check ;;
    *) repo="$arg" ;;
    esac
  done
  local system
  system="$(machine_system)" || exit 1
  FABRIEK_JSON="$json" fabriek_check_repo "$FABRIEK_SELF" "${repo:-.}" "$system"
}

## ls [--json] [REPO]: every specialist and skill, fabriek's and the
## repository's (ADR-042).
cmd_ls() {
  local json="" repo=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    --json) json=1 ;;
    -*) usage_error ls ;;
    *) repo="$arg" ;;
    esac
  done
  local system
  system="$(machine_system)" || exit 1
  FABRIEK_JSON="$json" fabriek_catalogue_list "$FABRIEK_SELF" "$system" "$repo"
}

## show [--json] NAME [REPO], or with -f, show ROLE: what one specialist
## brings, or what a registered factory's role is composed of, at its
## commit, no build (ADR-042).
cmd_show() {
  local json="" name="" repo=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    --json) json=1 ;;
    -*) usage_error show ;;
    *) if [[ -z "$name" ]]; then name="$arg"; else repo="$arg"; fi ;;
    esac
  done
  ## show -f FACTORY, nothing named: what a running factory is made of
  ## (ADR-057 point 7), the run's identity: the appliance, the pin, and the
  ## profile the machine built for each role.
  if [[ -z "$name" && (-n "$FACTORY_OPT" || -n "${FABRIEK_FACTORY:-}") ]]; then
    local factory dir profiles
    factory="$(factory_of "")" || exit 2
    dir="$(fabriek_machine_dir "$factory")" || exit 1
    fabriek_machine_running "$factory" || { log_err "$factory is not running; its profiles are the machine's to say"; exit 1; }
    profiles="$(machine factory-profiles "$factory")" || exit 1
    if [[ -n "$json" ]]; then
      printf '%s' "$profiles" | jq -c --arg image "$(readlink "$dir/appliance" 2>/dev/null || true)" '. + {image: $image}'
    else
      echo "image: $(readlink "$dir/appliance" 2>/dev/null || echo unknown)"
      printf '%s' "$profiles" | jq -r '"rev: \(.rev)", (.roles | to_entries[] | "  \(.key): \(.value)"), "  decider: \(.decider)"'
    fi
    return
  fi
  [[ -n "$name" ]] || usage_error show
  local system
  system="$(machine_system)" || exit 1
  if [[ -n "$FACTORY_OPT" || -n "${FABRIEK_FACTORY:-}" ]]; then
    local factory path
    factory="$(factory_of "")" || exit 2
    path="$(fabriek_operator_factory_path "$(fabriek_operator_config_path)" "$factory")" || exit 1
    FABRIEK_JSON="$json" fabriek_role_show "$FABRIEK_SELF" "$system" "$path" "$name"
  else
    FABRIEK_JSON="$json" fabriek_catalogue_show "$FABRIEK_SELF" "$system" "$name" "$repo"
  fi
}

## enter ROLE [-- CMD...]: a declared role by hand. A person: the session
## signs through their forwarded agent, exactly as entering an ordinary
## project does, and ADR-009's cage key belongs to the run nobody watches.
cmd_enter() {
  local factory role="${1:-}"
  [[ -n "$role" ]] || usage_error enter
  factory="$(factory_of "")" || exit 2
  shift
  [[ "${1:-}" == "--" ]] && shift

  # The socket the session signs through lives on the far side of the
  # transport, so it is named there rather than here: on macOS its path is the
  # VM's and nothing on this side can spell it. Both programs are told, and
  # they are told different things: nixcage forwards the agent and carries
  # the variable across sudo, fabriek-container reads it once it is there.
  local -a forward=() use_agent=()
  if [[ -n "${SSH_AUTH_SOCK:-}" && -e "${SSH_AUTH_SOCK}" ]]; then
    forward=(-A)
    use_agent=(--agent)
  fi
  if [[ $# -eq 0 ]]; then
    log_info "Entering role $role of factory $factory..."
    forward+=(-t)
  fi

  ## Where this factory's repository is, as a remote the machine can reach
  ## (ADR-032). The register names a checkout on this host, which the machine
  ## cannot open and which is not what it works from: the origin of that
  ## checkout is. The machine needs it the first time only, since after that
  ## its clone records where it was cloned from.
  local repository=()
  local origin
  if fabriek_operator_factory_path "$(fabriek_operator_config_path)" "$factory" >/dev/null 2>&1; then
    origin="$(factory_origin "$factory")" || exit 1
    repository=(--repository "$origin")
  fi

  local -a ssh_args=()
  machine_ssh_args "$factory" ssh_args || exit 1

  ## Same NUL framing as machine(), for the same reason: a session command is
  ## words the declaration wrote and nothing re-splits them on the way.
  printf '%s\0' role-enter ${use_agent[@]+"${use_agent[@]}"} \
    ${repository[@]+"${repository[@]}"} "$factory" "$role" "$@" |
    ssh "${ssh_args[@]}" ${forward[@]+"${forward[@]}"} root@localhost \
      xargs -0 fabriek-container
}

## stop [-k] ROLE: end a role's running turn through the executor; -k ends
## the cage itself at its scope (ADR-045), for a turn that no longer
## answers. Quiet on success.
cmd_stop() {
  local kill="" role=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    -k | --kill) kill=1 ;;
    -*) usage_error stop ;;
    *) role="$arg" ;;
    esac
  done
  [[ -n "$role" ]] || usage_error stop
  local factory
  factory="$(factory_of "")" || exit 2
  machine role-stop "$factory" "$role" ${kill:+--now} >/dev/null
}

## steer ROLE [TEXT|-]: speak into a role's running turn; the words go to
## the executor, which queues them at the next tool boundary.
cmd_steer() {
  local role="${1:-}"
  [[ -n "$role" ]] || usage_error steer
  local factory text
  factory="$(factory_of "")" || exit 2
  text="$(text_or_stdin "${2:-}")"
  [[ -n "$text" ]] || usage_error steer
  machine role-steer "$factory" "$role" "$text" >/dev/null
}

## log [-t] ROLE [SESSION]: the sessions pi kept in the role's home on the
## machine, or one of them, as it is or as the turns' text.
cmd_log() {
  local text="" role="" session=""
  local arg
  for arg in "$@"; do
    case "$arg" in
    -t | --text) text=1 ;;
    -*) usage_error log ;;
    *) if [[ -z "$role" ]]; then role="$arg"; else session="$arg"; fi ;;
    esac
  done
  [[ -n "$role" ]] || usage_error log
  local factory
  factory="$(factory_of "")" || exit 2
  ## Flags trail on the wire: the machine program reads the factory as its
  ## second word.
  machine role-transcript "$factory" "$role" ${session:+"$session"} ${text:+--text}
}

## file [-m BODY] WORKFLOW TITLE: a goal, filed into a factory. The
## workflow's first stage says who takes it and the decider says when; the
## title and body reach the machine as words and become files there, so the
## executor reads files and never argv (the second invariant). The body
## comes from -m or from stdin.
cmd_file() {
  local body="" workflow="" title=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -m | --message)
      body="${2:-}"
      shift 2 || usage_error file
      ;;
    -*) usage_error file ;;
    *)
      if [[ -z "$workflow" ]]; then workflow="$1"; elif [[ -z "$title" ]]; then title="$1"; else usage_error file; fi
      shift
      ;;
    esac
  done
  [[ -n "$workflow" && -n "$title" ]] || usage_error file
  [[ -n "$body" ]] || body="$(text_or_stdin "")"
  local factory
  factory="$(factory_of "")" || exit 2
  machine task-file "$factory" "$workflow" "$title" "$body"
}

## The factory as a whole: its one face, its board, its bus, a command from
## the operator, and its work handed to the operator's repository.
cmd_console() {
  [[ $# -eq 0 ]] || usage_error console
  local factory roles
  factory="$(factory_of "")" || exit 2
  ## The one face (ADR-039 point 3): the TUI, on this host, over the relay.
  ## Its roles come from the machine's declaration, over the same transport
  ## that carries the relay.
  roles="$(machine factory-roles "$factory")" || exit 1
  ## Every key in the TUI is a launcher command, typed at this launcher by
  ## path: "fabriek" is on no PATH the operator is obliged to have. The
  ## package sets it to the wrapped program; from the tree it is this file.
  export FABRIEK_CLI="${FABRIEK_CLI:-$(readlink -f "$0")}"
  # shellcheck disable=SC2086  # roles are one word each by construction
  exec fabriek-tui "$factory" $roles
}

cmd_board() {
  [[ $# -eq 0 ]] || usage_error board
  local factory
  factory="$(factory_of "")" || exit 2
  ## Merging is a click in Forgejo's UI and has no verb (ADR-036), and the
  ## UI is on the bridge, where only this factory's own ssh reaches: a
  ## local port is tunnelled to it over the same key and port every other
  ## verb uses, and held until interrupted. The machine says the address
  ## and sets the operator's password fresh, so nothing here guesses one.
  local answer addr password port
  answer="$(machine factory-board "$factory")" || exit 1
  addr="$(sed -n 1p <<<"$answer")"
  password="$(sed -n 2p <<<"$answer")"
  [[ -n "$addr" && -n "$password" ]] || { log_err "$factory did not say where its board is"; exit 1; }
  port="$(free_local_port)"
  local -a ssh_args=()
  machine_ssh_args "$factory" ssh_args || exit 1
  echo "http://127.0.0.1:$port/operator/$factory"
  echo "log in as operator with the password $password"
  echo "the tunnel holds until interrupted"
  exec ssh "${ssh_args[@]}" -N -L "127.0.0.1:$port:$addr" root@localhost
}

cmd_watch() {
  local factory
  factory="$(factory_of "")" || exit 2
  ## The bus as JSONL on stdout, relayed over the machine's ssh port; what
  ## the TUI reads, and what any other client would (ADR-039 point 2).
  machine factory-watch "$factory" "$@"
}

cmd_send() {
  [[ $# -le 1 ]] || usage_error send
  local factory json
  factory="$(factory_of "")" || exit 2
  json="$(text_or_stdin "${1:-}")"
  [[ -n "$json" ]] || usage_error send
  ## A command in the decider's vocabulary, from the operator, validated by
  ## the executor as the decider's would be.
  machine factory-send "$factory" "$json" >/dev/null
}

cmd_mirror() {
  [[ $# -eq 0 ]] || usage_error mirror
  local factory
  factory="$(factory_of "")" || exit 2
  ## Merged main and the record leave the machine on the operator's word
  ## and never before (ADR-036 point 7).
  machine factory-mirror "$factory"
}

cmd_help() {
  cat <<HELP
${BOLD}fabriek${NC} v${FABRIEK_VERSION}: a factory of named roles over one repository

${BOLD}Usage:${NC}
  fabriek [-f FACTORY] VERB [ARGS]

  The factory a verb is about: -f, else FABRIEK_FACTORY, else the one
  factory registered here. Every verb takes -h.

${BOLD}Commands:${NC}
  up [-u] [FACTORY]  Build and boot the machine a factory runs in, pinned to
                     the repository's commit; -u moves the pin to HEAD
  down [FACTORY]     Shut it down, reporting a stop that cannot complete
  ps [--json]        The machines on this host, and how each is reached
  check [REPO]       What up would refuse: the declaration at its commit and
                     every specialist each role names, in seconds, no build
  ls [REPO]          Every specialist and skill, fabriek's and the repository's
  show NAME [REPO]   What a specialist brings; with -f, what a role of the
                     factory is composed of, at its commit; with -f and no
                     NAME, what the running factory is made of: image, pin,
                     the profile built for each role
  enter ROLE [-- CMD...]
                     Enter a declared role in its own worktree and uid, by hand
  stop [-k] ROLE     End a role's running turn through the executor; -k ends
                     the cage at its scope
  steer ROLE [TEXT]  Speak into a role's running turn; TEXT or stdin
  log [-t] ROLE [SESSION]
                     The sessions pi kept for a role, or one of them, as it
                     is or, with -t, as the turns' text
  file [-m BODY] WORKFLOW TITLE
                     File a goal; the body from -m or stdin; the decider
                     assigns it and nothing is typed after
  console            The one face: roles, board, live stream, and the keys
  board              Forgejo's UI on a local port, for merging
  watch [--from ID]  The factory's bus as JSON lines, for any client
  send [JSON]        A command in the decider's vocabulary, from you
  mirror             Push merged main and the record to the repository's origin
  version            Print the version
  help               This

${BOLD}Configuration:${NC}
  $(fabriek_operator_config_path)
  [caps] what a factory may cost here; [factories.NAME] path = its checkout;
  [credentials.HOST] header and file; [models] HOST = the model to start on.
HELP
}

main() {
  ## -f FACTORY is taken wherever it stands before a "--", so it reads the
  ## same before and after the verb; everything else is the verb's.
  local -a rest=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -f | --factory)
      FACTORY_OPT="${2:-}"
      [[ -n "$FACTORY_OPT" ]] || usage_error ""
      shift 2
      ;;
    -f?*) FACTORY_OPT="${1#-f}"; shift ;;
    --)
      rest+=("$@")
      break
      ;;
    *)
      rest+=("$1")
      shift
      ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  ## Then the global flags that stand alone, before any verb.
  case "${1:-}" in
  -h | --help) cmd_help; exit 0 ;;
  -v | --version) echo "fabriek $FABRIEK_VERSION"; exit 0 ;;
  -*) usage_error "" ;;
  esac
  local command="${1:-help}"
  shift || true
  if wants_help "$@"; then
    case "$command" in
    help | version) cmd_help ;;
    *) usage_of "$command" ;;
    esac
    exit 0
  fi
  case "$command" in
  up)      cmd_up "$@" ;;
  down)    cmd_down "$@" ;;
  ps)      cmd_ps "$@" ;;
  check)   cmd_check "$@" ;;
  ls)      cmd_ls "$@" ;;
  show)    cmd_show "$@" ;;
  enter)   cmd_enter "$@" ;;
  stop)    cmd_stop "$@" ;;
  steer)   cmd_steer "$@" ;;
  log)     cmd_log "$@" ;;
  file)    cmd_file "$@" ;;
  console) cmd_console "$@" ;;
  board)   cmd_board "$@" ;;
  watch)   cmd_watch "$@" ;;
  send)    cmd_send "$@" ;;
  mirror)  cmd_mirror "$@" ;;
  version) echo "fabriek $FABRIEK_VERSION" ;;
  help)    cmd_help ;;
  *)
    log_err "unknown verb: $command"
    cmd_help >&2
    exit 2
    ;;
  esac
}

# Allow sourcing without executing (for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
